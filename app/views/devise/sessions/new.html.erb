<% content_for :title, "ログイン - Savedata" %>

<div class="min-h-screen bg-gradient-to-br from-blue-600 to-blue-800 px-4 py-12">
  <div class="w-full max-w-md mx-auto">

    <!-- ================= ヘッダー ================= -->
    <div class="text-center mb-6">

      <!-- トップ画 -->
      <div class="card-float-wrapper mb-2">
        <%= image_tag "dragon_card.png",
              class: "card-float mx-auto",
              alt: "dragon card" %>
      </div>

      <h1 class="text-2xl sm:text-5xl font-bold text-white font-pixel mb-1">
        Savedata
      </h1>

      <!-- ローディングバー -->
      <div class="flex justify-center mb-3">
        <div class="w-72 h-5 bg-black border-4 border-white rounded overflow-hidden">
          <div class="h-full bg-pink-400 animate-fill w-0"></div>
        </div>
      </div>
    </div>

    <!-- ================= 紹介文 ================= -->
    <div class="mb-8 text-center">
      <p class="text-lg leading-relaxed text-white">
        Savedataは、ゲームの思い出を<br>
        「年齢 × 時間軸」で<br>
        記録するアプリです。
      </p>
      <p class="text-sm leading-relaxed text-blue-200 mt-2">
        あの頃のプレイ体験を、感動を人生の年表として残そう。
      </p>
    </div>

    <!-- ================= 冒険をはじめる ================= -->
    <div id="adventure-start" class="rpg-side-window rounded-lg py-2 px-4 mb-6">
      <button type="button"
              onclick="showCommandSelect()"
              class="rpg-menu-item flex items-center w-full py-3 px-4 text-white text-sm text-left hover:bg-white/10 rounded transition">
        ぼうけんをはじめる
      </button>
    </div>

    <!-- ================= コマンド選択 ================= -->
    <div id="command-select" class="rpg-side-window rounded-lg py-2 px-4 mb-6" style="display:none;">

      <!-- Googleでログイン -->
      <%= button_to user_google_oauth2_omniauth_authorize_path,
            method: :post,
            form: { "data-turbo" => "false" },
            class: "rpg-menu-item flex items-center w-full py-3 px-4 text-white text-sm hover:bg-white/10 rounded transition text-left" do %>
        <svg class="w-4 h-4 mr-2 inline-block flex-shrink-0" viewBox="0 0 24 24">
          <path fill="#ffffff" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#ffffff" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#ffffff" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
          <path fill="#ffffff" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        Googleではじめる
      <% end %>

      <div class="border-t border-blue-400/30 mx-2"></div>

      <!-- はじめから -->
      <%= link_to new_registration_path(resource_name),
            class: "rpg-menu-item flex items-center py-3 px-4 text-white text-sm hover:bg-white/10 rounded transition block" do %>
        はじめから（メール）
      <% end %>

      <div class="border-t border-blue-400/30 mx-2"></div>

      <!-- つづきから -->
      <button type="button"
              onclick="document.getElementById('command-select').style.display='none'; document.getElementById('login-form').style.display='block';"
              class="rpg-menu-item flex items-center w-full py-3 px-4 text-white text-sm text-left hover:bg-white/10 rounded transition">
        つづきから（メール）
      </button>

    </div>

    <!-- ================= ログインフォーム（つづきから） ================= -->
    <div id="login-form" style="display:<%= resource.errors.any? ? 'block' : 'none' %>;">

      <!-- もどるボタン -->
      <button type="button"
              onclick="document.getElementById('login-form').style.display='none'; document.getElementById('command-select').style.display='block';"
              class="text-blue-200 text-xs hover:text-white mb-4 block">
        ← もどる
      </button>

      <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
        <h2 class="text-2xl text-gray-900 mb-4 text-center">ぼうけんの続き</h2>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name), local: true) do |f| %>

          <% if resource.errors.any? %>
            <div class="mb-6 p-4 bg-red-100 border border-red-400 rounded-md text-xs">
              <ul class="space-y-1 text-red-700">
                <% resource.errors.full_messages.each do |message| %>
                  <li>・<%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <!-- メールアドレス -->
          <div class="mb-5">
            <%= f.label :email, "メールアドレス",
                  class: "block text-xs font-semibold text-gray-700 mb-1" %>
            <%= f.email_field :email,
                  autofocus: true,
                  autocomplete: "email",
                  class: "w-full px-3 py-2 bg-gray-100 border border-gray-400 rounded-md" %>
          </div>

          <!-- パスワード -->
          <div class="mb-5">
            <%= f.label :password, "パスワード",
                  class: "block text-xs font-semibold text-gray-700 mb-1" %>
            <%= f.password_field :password,
                  autocomplete: "current-password",
                  class: "w-full px-3 py-2 bg-gray-100 border border-gray-400 rounded-md" %>
          </div>

          <!-- デバイスで記憶 -->
          <% if devise_mapping.rememberable? %>
            <div class="mb-6">
              <label class="flex items-center">
                <%= f.check_box :remember_me,
                      class: "w-4 h-4 border-gray-400 rounded" %>
                <span class="ml-2 text-xs text-gray-700">このデバイスで覚えておく</span>
              </label>
            </div>
          <% end %>
         <!-- パスワードをお忘れの方向け -->
          <%= f.submit "START",
                class: "w-full py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-md transition font-pixel" %>
            <div class="text-center text-xs">
              <%= link_to "パスワードをお忘れですか？",
                    new_password_path(resource_name),class: "text-gray-700" %>
            </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- ================= このアプリでできること） ================= -->
  <div class="w-full max-w-2xl mx-auto mt-16">

    <!-- FEATURES -->
    <div class="border-t border-blue-400/40 pt-4 pb-8">
      <h2 class="text-xl text-white text-center mb-6">このアプリでできること</h2>

      <!-- Book Carousel: CSS Sprite + Scroll-Timeline (Chrome 115+/134+) -->
      <div class="feat-book-container">
        <div class="feat-book">

          <!-- Sprite: page-flip animation driven by scroll-timeline -->
          <div class="feat-sprite"></div>

          <!-- Carousel -->
          <div class="feat-carousel">

            <!-- ── 機能 01: ゲームを登録 ── -->
            <div class="feat-carousel-item">
              <div class="feat-page-container">
                <div class="feat-page feat-left-page">
                  <p class="feat-page-icon">🎮</p>
                  <p class="feat-page-label">機能 01</p>
                  <p class="feat-page-title">ゲームを<br>登録</p>
                </div>
                <div class="feat-page feat-right-page">
                  <p class="feat-page-desc">
                    タイトル・プレイした年齢・ハード・ジャンル・面白さ・難易度・思い出メモを記録できます。<br><br>
                    あの頃のゲーム体験を、あらゆる角度から記録して永久に保存しましょう。
                  </p>
                </div>
              </div>
            </div>

            <!-- ── 機能 02: 年表タイムライン ── -->
            <div class="feat-carousel-item">
              <div class="feat-page-container">
                <div class="feat-page feat-left-page">
                  <p class="feat-page-icon">📅</p>
                  <p class="feat-page-label">機能 02</p>
                  <p class="feat-page-title">年表<br>タイムライン</p>
                </div>
                <div class="feat-page feat-right-page">
                  <p class="feat-page-desc">
                    登録ゲームが年齢順のタイムラインとして並び、自分のゲーム人生を一覧で振り返れます。<br><br>
                    幼少期から現在まで、ゲームとともに歩んだ軌跡が一目でわかります。
                  </p>
                </div>
              </div>
            </div>

            <!-- ── 機能 03: 思い出メモ ── -->
            <div class="feat-carousel-item">
              <div class="feat-page-container">
                <div class="feat-page feat-left-page">
                  <p class="feat-page-icon">💬</p>
                  <p class="feat-page-label">機能 03</p>
                  <p class="feat-page-title">思い出<br>メモ</p>
                </div>
                <div class="feat-page feat-right-page">
                  <p class="feat-page-desc">
                    「あの頃どんな気持ちで遊んだか」を感情とともに記録。ゲームを人生の記憶として残せます。<br><br>
                    感動・興奮・悔しさ・達成感――あの瞬間の気持ちを未来の自分へ。
                  </p>
                </div>
              </div>
            </div>

            <!-- ── 機能 04: 詳細カード ── -->
            <div class="feat-carousel-item">
              <div class="feat-page-container">
                <div class="feat-page feat-left-page">
                  <p class="feat-page-icon">🔍</p>
                  <p class="feat-page-label">機能 04</p>
                  <p class="feat-page-title">詳細<br>カード</p>
                </div>
                <div class="feat-page feat-right-page">
                  <p class="feat-page-desc">
                    ゲームカードをクリックすると思い出の詳細が表示され、編集・削除も行えます。<br><br>
                    記録はいつでも更新できます。新しい視点で昔のゲームを振り返ってみましょう。
                  </p>
                </div>
              </div>
            </div>

            <!-- ── 機能 05: シェア機能 ── -->
            <div class="feat-carousel-item">
              <div class="feat-page-container">
                <div class="feat-page feat-left-page">
                  <p class="feat-page-icon">🌐</p>
                  <p class="feat-page-label">機能 05</p>
                  <p class="feat-page-title">シェア機能</p>
                </div>
                <div class="feat-page feat-right-page">
                  <p class="feat-page-desc">
                    お気に入りのゲームをカード化してSNSに投稿できます。<br><br>
                    「あのゲーム知ってる！」という新しいつながりが生まれます。
                  </p>
                </div>
              </div>
            </div>

          </div><!-- /feat-carousel -->
        </div><!-- /feat-book -->
      </div><!-- /feat-book-container -->

    </div>

    <!--アプリの使い方-->
    <div class="border-t border-blue-400/40 pt-10 pb-8">
      <h2 class="text-xl text-white text-center mb-8">アプリの使い方</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

        <!-- STEP 01 -->
        <div class="flex flex-col items-center text-center bg-white/5 rounded-xl p-5">
          <div class="text-3xl mb-2">🎮</div>
          <div class="text-blue-200 text-xs font-semibold mb-1">STEP 01</div>
          <div class="text-white text-xs font-bold mb-2">アカウント作成</div>
          <div class="text-blue-100 text-xs leading-relaxed">
            SaveDataにアクセスし、新規登録を行います。冒険者名やパスワードをご入力ください。
          </div>
        </div>

        <!-- STEP 02 -->
        <div class="flex flex-col items-center text-center bg-white/5 rounded-xl p-5">
          <div class="text-3xl mb-2">💾</div>
          <div class="text-blue-200 text-xs font-semibold mb-1">STEP 02</div>
          <div class="text-white text-xs font-bold mb-2">セーブデータ登録</div>
          <div class="text-blue-100 text-xs leading-relaxed">
            プレイしたゲームの情報や思い出を登録。あの頃の冒険を記録として残せます。
          </div>
        </div>

        <!-- STEP 03 -->
        <div class="flex flex-col items-center text-center bg-white/5 rounded-xl p-5">
          <div class="text-3xl mb-2">🚀</div>
          <div class="text-blue-200 text-xs font-semibold mb-1">STEP 03</div>
          <div class="text-white text-xs font-bold mb-2">その他投稿が楽しくなる機能</div>
          <div class="text-blue-100 text-xs leading-relaxed">
            おすすめのゲームを占う機能、ゲームカードのSNSシェアなどなど色々ご用意してます！
          </div>
        </div>

      </div>
    </div>

    <!-- 利用規約・プライバシーポリシー -->
    <div class="mt-6 text-center text-xs text-blue-200 opacity-80">
      <%= link_to "利用規約", terms_path, class: "underline hover:opacity-100" %>
      ・
      <%= link_to "プライバシーポリシー", privacy_policy_path, class: "underline hover:opacity-100" %>
    </div>
    <!-- コピーライト -->
    <div class="mt-4 pb-6 text-center text-xs text-blue-300 opacity-50">
      &copy; <%= Time.current.year %> SaveData. All rights reserved.
    </div>
  </div>
</div>

<script>
  function showCommandSelect() {
    document.getElementById('adventure-start').style.display = 'none';
    var el = document.getElementById('command-select');
    el.style.display = 'block';
    el.classList.remove('rpg-modal');
    void el.offsetWidth;
    el.classList.add('rpg-modal');
  }

  document.querySelectorAll('.rpg-menu-item').forEach(function(el) {
      var cursor = document.createElement('span');
      cursor.textContent = '▶';
      cursor.style.cssText =
        'display:inline-block;' +
        'vertical-align:middle;' +
        'width:0;' +
        'min-width:0;' +
        'overflow:hidden;' +
        'white-space:nowrap;' +
        'margin-right:0;' +
        'transition:width 0.12s ease, margin-right 0.12s ease;';
      el.insertBefore(cursor, el.firstChild);

      el.addEventListener('mouseenter', function() {
        cursor.style.width = '1.2em';
        cursor.style.marginRight = '0.4em';
      });
      el.addEventListener('mouseleave', function() {
        cursor.style.width = '0';
        cursor.style.marginRight = '0';
      });
  });
</script>
