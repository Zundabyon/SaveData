<% content_for :title, "ログイン - Savedata" %>


<div class="min-h-screen bg-gradient-to-br from-blue-600 to-blue-800 px-4 py-12">
  <div class="w-full max-w-md mx-auto">

    <!-- ================= ヘッダー ================= -->
    <div class="text-center mb-6">

      <!-- トップ画 -->
      <div class="card-float-wrapper mb-2">
        <%= image_tag "dragon_card.png",
              class: "card-float mx-auto",
              alt: "dragon card" %>
      </div>

      <h1 class="text-2xl sm:text-5xl font-bold text-white font-pixel mb-1">
        Savedata
      </h1>

      <!-- ローディングバー -->
      <div class="flex justify-center mb-3">
        <div class="w-72 h-5 bg-black border-4 border-white rounded overflow-hidden">
          <div class="h-full bg-pink-400 animate-fill w-0"></div>
        </div>
      </div>
    </div>

    <!-- ================= 紹介文 ================= -->
    <div class="mb-8 text-center">
      <p class="text-lg leading-relaxed text-white">
        Savedataは、ゲームの思い出を<br>
        「年齢 × 時間軸」で<br>
        記録するアプリです。
      </p>
      <p class="text-sm leading-relaxed text-blue-200 mt-2">
        あの頃のプレイ体験を、感動を人生の年表として残そう。
      </p>
    </div>

    <!-- ================= 冒険をはじめる ================= -->
    <div id="adventure-start" class="rpg-side-window rounded-lg py-2 px-4 mb-6">
      <button type="button"
              onclick="showCommandSelect()"
              class="rpg-menu-item flex items-center w-full py-3 px-4 text-white text-sm text-left hover:bg-white/10 rounded transition">
        ぼうけんをはじめる
      </button>
    </div>

    <!-- ================= コマンド選択 ================= -->
    <div id="command-select" class="rpg-side-window rounded-lg py-2 px-4 mb-6" style="display:none;">

      <!-- Googleでログイン -->
      <%= button_to user_google_oauth2_omniauth_authorize_path,
            method: :post,
            form: { "data-turbo" => "false" },
            class: "rpg-menu-item flex items-center w-full py-3 px-4 text-white text-sm hover:bg-white/10 rounded transition text-left" do %>
        <svg class="w-4 h-4 mr-2 inline-block flex-shrink-0" viewBox="0 0 24 24">
          <path fill="#ffffff" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#ffffff" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#ffffff" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
          <path fill="#ffffff" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        Googleではじめる
      <% end %>

      <div class="border-t border-blue-400/30 mx-2"></div>

      <!-- はじめから -->
      <%= link_to new_registration_path(resource_name),
            class: "rpg-menu-item flex items-center py-3 px-4 text-white text-sm hover:bg-white/10 rounded transition block" do %>
        はじめから（メール）
      <% end %>

      <div class="border-t border-blue-400/30 mx-2"></div>

      <!-- つづきから -->
      <button type="button"
              onclick="document.getElementById('command-select').style.display='none'; document.getElementById('login-form').style.display='block';"
              class="rpg-menu-item flex items-center w-full py-3 px-4 text-white text-sm text-left hover:bg-white/10 rounded transition">
        つづきから（メール）
      </button>

    </div>

    <!-- ================= ログインフォーム（つづきから） ================= -->
    <div id="login-form" style="display:<%= resource.errors.any? ? 'block' : 'none' %>;">

      <!-- もどるボタン -->
      <button type="button"
              onclick="document.getElementById('login-form').style.display='none'; document.getElementById('command-select').style.display='block';"
              class="text-blue-200 text-xs hover:text-white mb-4 block">
        ← もどる
      </button>

      <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
        <h2 class="text-2xl text-gray-900 mb-4 text-center">ぼうけんの続き</h2>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name), local: true) do |f| %>

          <% if resource.errors.any? %>
            <div class="mb-6 p-4 bg-red-100 border border-red-400 rounded-md text-xs">
              <ul class="space-y-1 text-red-700">
                <% resource.errors.full_messages.each do |message| %>
                  <li>・<%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <!-- メールアドレス -->
          <div class="mb-5">
            <%= f.label :email, "メールアドレス",
                  class: "block text-xs font-semibold text-gray-700 mb-1" %>
            <%= f.email_field :email,
                  autofocus: true,
                  autocomplete: "email",
                  class: "w-full px-3 py-2 bg-gray-100 border border-gray-400 rounded-md" %>
          </div>

          <!-- パスワード -->
          <div class="mb-5">
            <%= f.label :password, "パスワード",
                  class: "block text-xs font-semibold text-gray-700 mb-1" %>
            <%= f.password_field :password,
                  autocomplete: "current-password",
                  class: "w-full px-3 py-2 bg-gray-100 border border-gray-400 rounded-md" %>
          </div>

          <!-- デバイスで記憶 -->
          <% if devise_mapping.rememberable? %>
            <div class="mb-6">
              <label class="flex items-center">
                <%= f.check_box :remember_me,
                      class: "w-4 h-4 border-gray-400 rounded" %>
                <span class="ml-2 text-xs text-gray-700">このデバイスで覚えておく</span>
              </label>
            </div>
          <% end %>
         <!-- パスワードをお忘れの方向け -->
          <%= f.submit "START",
                class: "w-full py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-md transition font-pixel" %>
            <div class="text-center text-xs">
              <%= link_to "パスワードをお忘れですか？",
                    new_password_path(resource_name),class: "text-gray-700" %>
            </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="w-full max-w-2xl mx-auto mt-16">
<!-- ================= このアプリでできること ================= -->
<div class="border-t border-blue-400/40 pt-4 pb-8">
  <h2 class="text-xl text-white text-center mb-6">このアプリでできること</h2>

  <div class="relative px-10">
    <!-- 左矢印 -->
    <button class="carousel-3d-btn carousel-3d-btn-left" id="feat-prev">◀</button>

    <!-- カルーセル本体 -->
    <div class="carousel-3d-wrapper">
      <div class="carousel-3d-track" id="feat-track">

        <div class="carousel-3d-item"
             data-icon="🎮"
             data-label="機能 01"
             data-title="ゲームを登録"
             data-desc="ゲームタイトルを検索するだけで、カバー画像・ジャンル・対応ハードを自動取得。プレイした年齢・面白さ・難易度（5段階）・思い出メモも記録できます。">
          <p class="carousel-3d-icon">🎮</p>
          <p class="carousel-3d-label">機能 01</p>
          <p class="carousel-3d-title">ゲームを<br>登録</p>
        </div>

        <div class="carousel-3d-item"
             data-icon="📅"
             data-label="機能 02"
             data-title="年表タイムライン"
             data-desc="登録したゲームが「プレイした年齢順」のタイムラインとして並びます。幼少期から現在まで、自分だけの人生の年表を一画面で振り返れます。">
          <p class="carousel-3d-icon">📅</p>
          <p class="carousel-3d-label">機能 02</p>
          <p class="carousel-3d-title">年表<br>タイムライン</p>
        </div>

        <div class="carousel-3d-item"
             data-icon="💬"
             data-label="機能 03"
             data-title="思い出メモ"
             data-desc="「あの頃どんな気持ちで遊んだか」を感情とともに記録。感動・興奮・悔しさ・達成感――あの瞬間の気持ちを、未来の自分へ。">
          <p class="carousel-3d-icon">💬</p>
          <p class="carousel-3d-label">機能 03</p>
          <p class="carousel-3d-title">思い出<br>メモ</p>
        </div>

        <div class="carousel-3d-item"
             data-icon="🔍"
             data-label="機能 04"
             data-title="詳細カード"
             data-desc="ゲームカードをクリックすると思い出の詳細が表示され、編集・削除も行えます。新しい視点で昔のゲームを振り返ってみましょう。">
          <p class="carousel-3d-icon">🔍</p>
          <p class="carousel-3d-label">機能 04</p>
          <p class="carousel-3d-title">詳細<br>カード</p>
        </div>

        <div class="carousel-3d-item"
             data-icon="🌐"
             data-label="機能 05"
             data-title="シェア機能"
             data-desc="お気に入りのゲームをカード画像として生成し、X（旧Twitter）に投稿できます。世代を超えた共感が生まれます。">
          <p class="carousel-3d-icon">🌐</p>
          <p class="carousel-3d-label">機能 05</p>
          <p class="carousel-3d-title">シェア機能</p>
        </div>

        <div class="carousel-3d-item"
             data-icon="🔮"
             data-label="機能 06"
             data-title="占いおばばの部屋"
             data-desc="謎の占いおばばが、あなたに合ったゲームを占います。神秘的な視点からのゲーム提案をお楽しみください。さて、運命のゲームとは……？">
          <p class="carousel-3d-icon">🔮</p>
          <p class="carousel-3d-label">機能 06</p>
          <p class="carousel-3d-title">占いおばばの部屋</p>
        </div>

      </div>
    </div>

    <!-- 右矢印 -->
    <button class="carousel-3d-btn carousel-3d-btn-right" id="feat-next">▶</button>
  </div>

  <!-- 説明文エリア -->
  <div class="carousel-3d-desc" id="feat-desc">
    ゲームタイトルを検索するだけで、カバー画像・ジャンル・対応ハードを自動取得。プレイした年齢・面白さ・難易度（5段階）・思い出メモも記録できます。
  </div>
</div>
    <!--アプリの使い方-->
    <div class="border-t border-blue-400/40 pt-10 pb-8">
