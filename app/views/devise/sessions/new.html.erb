// ================= CSS関連（ここにしか反映させない為切り分けなし） =================
<style>
.carousel-3d-wrapper { position: relative; width: 100%; height: 220px; perspective: 900px; }
.carousel-3d-track { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; }
.carousel-3d-item { position: absolute; width: 140px; height: 180px; left: 50%; top: 50%; border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; transition: all 0.5s cubic-bezier(0.25,0.46,0.45,0.94); background: rgba(255,255,255,0.15); border: 2px solid rgba(255,255,255,0.3); user-select: none; text-align: center; padding: 12px; box-sizing: border-box; }
.carousel-3d-item.level-0 { transform: translateX(-50%) translateY(-50%) translateZ(0px) scale(1); background: rgba(255,255,255,0.25); border-color: rgba(255,255,255,0.7); box-shadow: 0 8px 32px rgba(0,0,0,0.4); z-index: 10; opacity: 1; }
.carousel-3d-item.level-1 { transform: translateX(calc(-50% + 160px)) translateY(-50%) translateZ(-80px) scale(0.85); background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.3); z-index: 5; opacity: 0.7; }
.carousel-3d-item.level-m1 { transform: translateX(calc(-50% - 160px)) translateY(-50%) translateZ(-80px) scale(0.85); background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.3); z-index: 5; opacity: 0.7; }
.carousel-3d-item.level-2 { transform: translateX(calc(-50% + 280px)) translateY(-50%) translateZ(-160px) scale(0.7); background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.15); z-index: 1; opacity: 0.4; }
.carousel-3d-item.level-m2 { transform: translateX(calc(-50% - 280px)) translateY(-50%) translateZ(-160px) scale(0.7); background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.15); z-index: 1; opacity: 0.4; }
.carousel-3d-item.level-hidden { opacity: 0; pointer-events: none; z-index: 0; }
.carousel-3d-icon { font-size: 2.8rem; margin-bottom: 6px; }
.carousel-3d-label { font-size: 0.55rem; color: rgba(200,220,255,0.9); margin-bottom: 4px; font-family: 'DotGothic16', monospace; }
.carousel-3d-title { font-size: 0.8rem; font-weight: bold; color: #fff; font-family: 'DotGothic16', monospace; line-height: 1.5; }
.carousel-3d-desc { min-height: 80px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.2); border-radius: 10px; padding: 14px 18px; margin-top: 16px; color: #e0eeff; font-size: 0.78rem; line-height: 1.8; font-family: 'DotGothic16', monospace; text-align: center; transition: opacity 0.3s ease; }
.carousel-3d-btn { position: absolute; top: 50%; transform: translateY(-50%); width: 34px; height: 34px; background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.3); border-radius: 50%; color: rgba(255,255,255,0.9); font-size: 0.85rem; cursor: pointer; z-index: 20; display: flex; align-items: center; justify-content: center; transition: background 0.2s; }
.carousel-3d-btn:hover { background: rgba(0,0,0,0.65); }
.carousel-3d-btn-left { left: 0; }
.carousel-3d-btn-right { right: 0; }
@media (max-width: 640px) {
  .carousel-3d-wrapper { height: 180px; }
  .carousel-3d-item { width: 110px; height: 150px; }
  .carousel-3d-item.level-1 { transform: translateX(calc(-50% + 120px)) translateY(-50%) translateZ(-60px) scale(0.8); }
  .carousel-3d-item.level-m1 { transform: translateX(calc(-50% - 120px)) translateY(-50%) translateZ(-60px) scale(0.8); }
  .carousel-3d-item.level-2 { transform: translateX(calc(-50% + 210px)) translateY(-50%) translateZ(-120px) scale(0.65); }
  .carousel-3d-item.level-m2 { transform: translateX(calc(-50% - 210px)) translateY(-50%) translateZ(-120px) scale(0.65); }
  .carousel-3d-icon { font-size: 2rem; }
  .carousel-3d-title { font-size: 0.65rem; }
}
</style>

<script>
// ── 3Dカルーセル ──
(function() {
  const items   = Array.from(document.querySelectorAll('.carousel-3d-item'));
  const desc    = document.getElementById('feat-desc');
  const total   = items.length;
  let active    = 0;

  const levels  = ['level-m2','level-m1','level-0','level-1','level-2'];

  function getLevel(index) {
    const diff = ((index - active) % total + total) % total;
    const d    = diff > total / 2 ? diff - total : diff;
    if (d === 0)  return 'level-0';
    if (d === 1)  return 'level-1';
    if (d === -1) return 'level-m1';
    if (d === 2)  return 'level-2';
    if (d === -2) return 'level-m2';
    return 'level-hidden';
  }

  function render() {
    items.forEach((el, i) => {
      el.className = 'carousel-3d-item ' + getLevel(i);
    });
    desc.style.opacity = '0';
    setTimeout(() => {
      desc.textContent   = items[active].dataset.desc;
      desc.style.opacity = '1';
    }, 150);
  }

  document.getElementById('feat-prev').addEventListener('click', function() {
    active = (active - 1 + total) % total;
    render();
  });

  document.getElementById('feat-next').addEventListener('click', function() {
    active = (active + 1) % total;
    render();
  });

  items.forEach((el, i) => {
    el.addEventListener('click', function() {
      active = i;
      render();
    });
  });

  render();
})();
  function showCommandSelect() {
    document.getElementById('adventure-start').style.display = 'none';
    var el = document.getElementById('command-select');
    el.style.display = 'block';
    el.classList.remove('rpg-modal');
    void el.offsetWidth;
    el.classList.add('rpg-modal');
  }

  function showCommandSelectBottom() {
    document.getElementById('adventure-start-bottom').style.display = 'none';
    var el = document.getElementById('command-select-bottom');
    el.style.display = 'block';
    el.classList.remove('rpg-modal');
    void el.offsetWidth;
    el.classList.add('rpg-modal');
  }

  document.querySelectorAll('.rpg-menu-item').forEach(function(el) {
      var cursor = document.createElement('span');
      cursor.textContent = '▶';
      cursor.style.cssText =
        'display:inline-block;' +
        'vertical-align:middle;' +
        'width:0;' +
        'min-width:0;' +
        'overflow:hidden;' +
        'white-space:nowrap;' +
        'margin-right:0;' +
        'transition:width 0.12s ease, margin-right 0.12s ease;';
      el.insertBefore(cursor, el.firstChild);

      el.addEventListener('mouseenter', function() {
        cursor.style.width = '1.2em';
        cursor.style.marginRight = '0.4em';
      });
      el.addEventListener('mouseleave', function() {
        cursor.style.width = '0';
        cursor.style.marginRight = '0';
      });
  });
</script>
