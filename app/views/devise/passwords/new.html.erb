<!-- app/views/devise/passwords/new.html.erb -->

<div class="min-h-screen flex items-center justify-center px-4 py-12">
  <div class="max-w-md w-full rpg-side-window p-8">
    
    <!-- タイトル -->
    <h2 class="text-2xl font-bold text-center mb-6 text-blue-100 tracking-widest">
      パスワードを　お忘れですか？
    </h2>
    
    <p class="text-sm text-blue-200 text-center mb-6 leading-relaxed">
      登録した メールアドレスを<br>
      ご入力 ください。<br>
      パスワード リセット用の<br>
      リンクを 送信します。
    </p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- メールアドレス -->
      <div class="mb-6">
        <%= f.label :email, "メールアドレス", class: "block text-sm font-bold text-blue-200 mb-2" %>
        <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            placeholder: "example@example.com",
            class: "w-full px-4 py-2 bg-black/30 border border-blue-300/50 rounded-md text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <!-- 送信ボタン -->
      <div class="mb-6">
        <%= f.submit "リセットメールを　送信",
            class: "rpg-command w-full text-center cursor-pointer" %>
      </div>
    <% end %>

  </div>
</div>