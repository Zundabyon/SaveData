<% content_for :title, "パスワード再設定 - SaveData" %>

<div class="min-h-screen bg-gradient-to-br from-blue-600 to-blue-800 px-4 py-12">
  <div class="mx-auto w-full max-w-md">

    <!-- カード -->
    <div class="rounded-2xl bg-white/95 shadow-xl p-8 md:p-10">

      <!-- タイトル -->
      <h1 class="text-2xl font-bold text-gray-800 mb-6 text-center">
        パスワードをお忘れですか？
      </h1>

      <!-- フォーム -->
      <%= form_for(resource, as: resource_name,
                   url: password_path(resource_name),
                   html: { method: :post, class: "space-y-6" }) do |f| %>

        <!-- エラー表示 -->
        <%= render "devise/shared/error_messages", resource: resource %>

        <!-- メール -->
        <div>
          <%= f.label :email, "メールアドレス",
                class: "block text-sm font-medium text-gray-700 mb-1" %>

          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                class: "w-full rounded-lg border border-gray-300 px-4 py-2
                        focus:outline-none focus:ring-2 focus:ring-blue-500
                        focus:border-transparent" %>
        </div>

        <!-- ボタン -->
        <div>
          <%= f.submit "再設定メールを送信",
                class: "w-full rounded-xl bg-blue-600 py-3 text-white font-semibold
                        shadow-md hover:bg-blue-700 transition" %>
                        <p>※未実装です。</p>
        </div>

      <% end %>
    </div>

    <!-- 戻る -->
    <div class="mt-8 flex justify-center">
      <%= link_to "トップへ戻る", root_path,
          class: "inline-flex items-center justify-center
                  rounded-xl bg-blue-600 px-6 py-3
                  text-white font-semibold
                  shadow-md
                  hover:bg-blue-700
                  transition" %>
    </div>

  </div>
</div>
