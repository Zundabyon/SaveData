<% content_for :title, "設定変更 - Savedata" %>

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-600 to-blue-800 px-4 py-12">
  <div class="w-full max-w-md">
    <!-- タイトル -->
      <div class="text-center mb-8 text-white">
        <h1 class="text-2xl font-pixel mb-2">
          EDIT DATA
        </h1>
        <p class="text-sm">
          冒険者情報を更新
        </p>
      </div>

    <!-- メモリーカード -->
    <div class="bg-gray-300 border border-gray-400 rounded-xl shadow-md px-8 py-10">

      <%= form_for(resource,
            as: resource_name,
            url: registration_path(resource_name),
            html: { method: :put }) do |f| %>

        <%= render "devise/shared/error_messages", resource: resource %>

        <!-- 名前 -->
        <div class="mb-4">
          <%= f.label :name, "プレイヤー名",
            class: "block text-xs font-semibold text-gray-700 mb-1" %>
          <%= f.text_field :name,
            class: "w-full px-3 py-2 bg-gray-100 border border-gray-400 rounded-md" %>
        </div>

        <!-- 誕生日 -->
        <div class="mb-4">
          <%= f.label :birthday, "誕生日",
            class: "block text-xs font-semibold text-gray-700 mb-1" %>
          <%= f.date_field :birthday,
            class: "w-full px-3 py-2 bg-gray-100 border border-gray-400 rounded-md" %>
        </div>

        <!-- 性別（enum対応） -->
        <div class="mb-5">
          <%= f.label :gender, "性別",
            class: "block text-xs font-semibold text-gray-700 mb-1" %>
          <%= f.select :gender,
            [["男性", "male"], ["女性", "female"]],
            { include_blank: "選択してください" },
            class: "w-full px-3 py-2 bg-gray-100 border border-gray-400 rounded-md" %>
        </div>

        <!-- 職業 -->
        <div class="mb-5">
          <%= f.label :job, "職業",
            class: "block text-xs font-semibold text-gray-700 mb-1" %>
          <%= f.select :job,
           [
            ["せんし", "warrior"],
            ["まほうつかい", "mage"],
            ["とうぞく", "thief"],
            ["そうりょ", "priest"],
            ["ゆうしゃ", "fighter"],
            ["しにがみ", "devil"],
            ["Figma職人", "figma_master"],
            ["ロブスター", "lobster"],
            ["その他", "other"]
           ],
            { include_blank: "選択してください" },
            class: "w-full px-3 py-2 bg-gray-100 border border-gray-400 rounded-md" %>
        </div>

        <!-- 区切り線 -->
        <div class="border-t border-gray-400 my-6"></div>

        <!-- パスワード変更セクション -->
        <div class="mb-4">
          <p class="text-xs font-bold text-gray-700 mb-3">パスワード変更（変更する場合のみ入力）</p>
          
          <!-- 新しいパスワード -->
          <div class="mb-4">
            <%= f.label :password, "新しいパスワード",
              class: "block text-xs font-semibold text-gray-700 mb-1" %>
            <%= f.password_field :password,
              autocomplete: "new-password",
              placeholder: "変更しない場合は空欄",
              class: "w-full px-3 py-2 bg-gray-100 border border-gray-400 rounded-md" %>
            <p class="text-xs text-gray-600 mt-1">※ 6文字以上</p>
          </div>

          <!-- パスワード確認 -->
          <div class="mb-4">
            <%= f.label :password_confirmation, "新しいパスワード（確認）",
              class: "block text-xs font-semibold text-gray-700 mb-1" %>
            <%= f.password_field :password_confirmation,
              autocomplete: "new-password",
              placeholder: "変更しない場合は空欄",
              class: "w-full px-3 py-2 bg-gray-100 border border-gray-400 rounded-md" %>
          </div>
        </div>

        <!-- 区切り線 -->
        <div class="border-t border-gray-400 my-6"></div>

        <!-- 現在のパスワード（必須） -->
        <div class="mb-5">
          <%= f.label :current_password, "現在のパスワード（必須）",
            class: "block text-xs font-semibold text-gray-700 mb-1" %>
          <%= f.password_field :current_password,
            autocomplete: "current-password",
            class: "w-full px-3 py-2 bg-gray-100 border border-gray-400 rounded-md" %>
          <p class="text-xs text-gray-600 mt-1">※ 変更を保存するには現在のパスワードが必要です</p>
        </div>

        <!-- ボタン -->
        <div class="text-center flex justify-center gap-4 font-pixel">
          <%= link_to "CANCEL",
            dashboard_path,
            class: "px-6 py-2 bg-red-700 text-white rounded hover:bg-red-800 transition" %>
          <%= f.submit "UPDATE",
            class: "px-6 py-2 bg-blue-700 text-white rounded hover:bg-blue-800 transition" %>
        </div>

      <% end %>

    </div>
  </div>
</div>