<div class="div class= min-h-screen flex flex-col items-center justify-start py-12 px-4">
    <%# タイトルエリア %>
  <div class="text-center mb-10">
    <h1 class="text-4xl font-bold text-white mb-4" style="text-shadow: 0 0 20px rgba(253,224,71,0.5);">
      市役所兼冒険者ギルド
    </h1>
    <%= image_tag "guild_girl.png", class: "mx-auto mb-4", style: "width: 600px; height: 300px;" %>
    <p class="text-blue-200 text-sm tracking-widest">
      <%= current_user.name %>さん、冒険者免許証を発行しました！<br>
      これからの冒険が素晴らしいものになりますように！✨
    </p>
  </div>
    <div class="bg-gray-200 border-4 border-gray-400 rounded-2xl shadow-2xl overflow-hidden relative">

      <div class="bg-gray-600 text-white px-4 py-2 flex justify-between items-center">
        <span class="text-xs tracking-tighter">BOUKENSYA NO LICENSE</span>
        <span class="text-sm font-bold">冒険者免許証</span>
      </div>

      <div class="p-6">
        <div class="flex gap-4 mb-6">
          <div class="shrink-0">
            <div class="w-28 h-32 bg-white border-2 border-gray-400 shadow-inner flex items-center justify-center overflow-hidden">
              <%= image_tag "jobs/#{job_image_filename(@user.job)}",
              class: "profile-image object-contain w-full h-full",
              alt: @user.job || "職業未設定" %>
            </div>
          </div>

          <div class="flex-grow flex flex-col justify-end pb-2">
            <div class="border-b border-blue-600 mb-4">
              <span class="text-[10px] text-blue-700 font-bold block">種別</span>
              <span class="text-lg font-bold text-gray-800">冒険者</span>
            </div>
            <div class="border-b-2 border-blue-600">
              <span class="text-[10px] text-blue-700 font-bold block">氏名</span>
              <span class="text-xl font-black text-gray-900 tracking-tighter">
                <%= @user.name.presence || "名無しの冒険者" %>
              </span>
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <div class="flex gap-2">
            <div class="flex-grow bg-white border border-gray-300 p-2 rounded">
              <span class="text-[10px] text-gray-500 block">現在のジョブ</span>
              <span class="font-bold text-gray-800"><%= job_hiragana(@user.job) %></span>
            </div>
            <div class="w-24 bg-white border border-gray-300 p-2 rounded text-center">
              <span class="text-[10px] text-gray-500 block">レベル</span>
              <span class="text-xl font-black  text-black"><%= @user.games.count %></span>
            </div>
            <div class="w-24 bg-white border border-gray-300 p-2 rounded text-center">
              <span class="text-[10px] text-gray-500 block">ランク</span>
              <span class="text-xl font-black text-yellow-600">
                <%# LVに応じてランクを変える演出例 %>
                <%= @user.games.count > 2 ? "A" : "B" %>
              </span>
            </div>
          </div>

          <div class="bg-white border border-gray-300 p-2 rounded">
            <span class="text-[10px] text-gray-500 block">特記・得意ジャンル</span>
            <span class="text-sm font-bold text-gray-700">
              <%= @favorite_genre.presence || "未登録" %>
            </span>
          </div>

          <div class="text-xs text-gray-500 leading-tight">
            * 本証は冒険者ギルドが定める基準を満たした者に交付される。<br>
            * 有効期限：世界に平和が訪れるまで
          </div>
        </div>
      </div>

      <div class="absolute bottom-16 right-4 w-12 h-12 border-2 border-red-500 rounded-full flex items-center justify-center rotate-12 opacity-30 pointer-events-none">
        <span class="text-[10px] text-red-600 font-bold text-center leading-none">ギルド<br>公認</span>
      </div>
    </div>
        <div class="mt-6 justify-center flex gap-4">
           
          <%= link_to edit_user_registration_path,
          class: "inline-flex items-center justify-center rounded-xl bg-blue-600 px-6 py-3 text-white font-semibold shadow-md hover:bg-blue-700 transition" do %>
            登録情報の変更<br>（ギルドへ申請）
          <% end %>
          <%= link_to dashboard_path,
          class: "inline-flex items-center justify-center rounded-xl bg-red-600 px-6 py-3 text-white font-semibold shadow-md hover:bg-red-700 transition" do %>
            冒険記録一覧へ
          <% end %>
        </div>
</div>