<div class="min-h-screen flex flex-col md:flex-row">
  
  <!-- 左側：説明文（50%） -->
  <div class="w-full md:w-1/2 bg-gradient-to-br from-blue-600 to-blue-800 flex items-center justify-center px-8 md:px-12 py-12 md:py-0">
    <div class="text-white max-w-xl w-full">
      <h2 class="text-4xl md:text-5xl font-pixel mb-8 md:mb-12 text-center leading-tight">
        EDIT DATA
      </h2>
      
      <div class="space-y-6 md:space-y-8 text-base md:text-lg leading-relaxed">
        <p class="text-center text-lg md:text-xl">
          セーブデータを更新
        </p>
        
        <div class="bg-blue-900/40 border-2 border-blue-300/50 rounded-lg p-5 md:p-6">
          <p class="font-bold text-lg md:text-xl mb-3 md:mb-4 font-pixel">TIPS</p>
          <ul class="space-y-2 md:space-y-3 text-sm md:text-base">
            <li>• タイトルは正確に入力すると後で探しやすい</li>
            <li>• 何歳でプレイしたかを記録すると思い出が鮮明に</li>
            <li>• メモには当時の感想や印象を自由に</li>
            <li>• 画像があると年表がより華やかに</li>
          </ul>
        </div>
        
        <p class="text-xs md:text-sm text-blue-200 text-center">
          全ての項目は後から編集できます
        </p>
      </div>
    </div>
  </div>

<!-- 右側：フォーム（50%） -->
<div class="w-full md:w-1/2 bg-gray-300 overflow-y-auto">
  <div class="min-h-screen flex items-center justify-center px-6 md:px-10 py-8">
    <div class="w-full max-w-xl">
      <%= render "form", game: @game %>
    </div>
  </div>
</div>
</div>