<%= form_with model: game, local: true, html: { multipart: true } do |f| %>

  <!-- エラー表示 -->
  <% if game.errors.any? %>
    <div class="mb-4 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg">
      <p class="font-bold text-sm">
        入力内容に<%= game.errors.count %>件のエラーがあります
      </p>
      <ul class="list-disc list-inside mt-2 text-xs">
        <% game.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- タイトル -->
  <div class="mb-4">
    <%= f.label :title, "ゲーム選択",
          class: "block text-xl font-bold text-gray-800 mb-1" %>
    <%= f.text_field :title, placeholder: "例: ファイナルファンタジーVII",
          class: "w-full px-3 py-2 bg-white border border-gray-400 rounded text-sm focus:outline-none focus:ring-1 focus:ring-blue-500" %>
  <button type="button" id="search_title"
          class="mt-2 text-sm text-blue-600 hover:underline">
    検索
  </button>
  <p>英語でタイトルで入力すると出やすいよ！</p>

    <!-- IGDB検索結果 -->
  <div id="igdb-results"
       class="mt-2 border border-gray-300 rounded bg-white max-h-96 overflow-y-auto"
       style="display: none;">
  </div>

  <!-- 選択したゲームのプレビュー -->
  <div id="igdb-selected-preview" class="mt-2 hidden">
    <div class="flex items-center gap-3 p-2 bg-blue-50 border border-blue-300 rounded">
      <img id="igdb-selected-img" src="" class="w-12 h-16 object-cover rounded border border-blue-300" alt="">
      <div class="flex-1">
        <p class="text-xs text-blue-500 font-semibold">IGDBから選択中</p>
        <p id="igdb-selected-name" class="text-sm font-bold text-gray-800"></p>
      </div>
      <button type="button" id="igdb-clear-btn" class="text-xs text-red-500 hover:underline">クリア</button>
    </div>
  </div>

  <!-- igdb APIで取得した画像を隠して入れておく場所 -->
  <%= f.hidden_field :igdb_cover_url, id: "igdb_cover_url" %>

  </div>

  <!-- ハードとジャンルを横並び -->
  <div class="grid grid-cols-2 gap-3 mb-4">
    <!-- ゲーム機 -->
    <div>
      <%= f.label :hardware, "遊んだゲーム機",
            class: "block text-xl font-bold text-gray-800 mb-1" %>
      <%= f.grouped_collection_select :hardware,
            Game::HARDWARE_GROUPED, :last, :first, :itself, :itself,
            { include_blank: "-- 選択 --" },
            class: "w-full px-3 py-2 bg-white border border-gray-400 rounded text-sm" %>
    </div>

    <!-- ジャンル -->
    <div>
      <%= f.label :genre, "ジャンル",
            class: "block text-xl font-bold text-gray-800 mb-1" %>
      <%= f.select :genre,
            Game::GENRE_OPTIONS,
            { include_blank: "-- 選択 --" },
            class: "w-full px-3 py-2 bg-white border border-gray-400 rounded text-sm" %>
    </div>
  </div>

  <!-- プレイした年齢 -->
  <div class="mb-4">
    <%= f.label :played_age, "何歳くらいにプレイした？",
          class: "block text-xl font-bold text-gray-800 mb-1" %>
    <%= f.number_field :played_age,
          placeholder: "例: 15",
          class: "w-full px-3 py-2 bg-white border border-gray-400 rounded text-sm" %>
  </div>

<!-- 評価を横並び -->
  <div class="grid grid-cols-2 gap-4 mb-4">
    <!-- ゲームの楽しさ -->
    <div class="bg-white p-3 rounded border border-gray-300">
      <p class="text-xl font-bold text-gray-800 mb-2 text-center">楽しさ</p>
      <div class="flex flex-row-reverse justify-center gap-1">
        <% 10.downto(1) do |i| %>
          <%= f.radio_button :fun, i, id: "fun_#{i}", class: "hidden" %>
          <label for="fun_<%= i %>" class="cursor-pointer">
            <span class="materia materia-green inline-block <%= 'inactive' unless game.fun && game.fun >= i %>" 
                  data-rating="<%= i %>"
                  data-type="fun"></span>
          </label>
        <% end %>
      </div>
      <p class="text-xs text-center mt-2 text-gray-600">クリックで選択</p>
    </div>

    <!-- ゲームの難しさ -->
    <div class="bg-white p-3 rounded border border-gray-300">
      <p class="text-xl font-bold text-gray-800 mb-2 text-center">難しさ</p>
      <div class="flex flex-row-reverse justify-center gap-1">
        <% 10.downto(1) do |i| %>
          <%= f.radio_button :difficulty, i, id: "difficulty_#{i}", class: "hidden" %>
          <label for="difficulty_<%= i %>" class="cursor-pointer">
            <span class="materia materia-red inline-block <%= 'inactive' unless game.difficulty && game.difficulty >= i %>" 
                  data-rating="<%= i %>"
                  data-type="difficulty"></span>
          </label>
        <% end %>
      </div>
      <p class="text-xs text-center mt-2 text-gray-600">クリックで選択</p>
    </div>
  </div>

  <!-- メモ -->
  <div class="mb-4">
    <%= f.label :memo, "ひとことメモ ※150文字以内",
          class: "block text-xl font-bold text-gray-800 mb-1" %>
    <%= f.text_area :memo,
          rows: 3,
          placeholder: "当時の感想や思い出を自由に...",
          class: "w-full px-3 py-2 bg-white border border-gray-400 rounded text-sm" %>
  </div>

  <!-- カバー画像 -->
  <div class="mb-5">
    <%= f.label :cover_image, "カバー画像",
          class: "block text-xl font-bold text-gray-800 mb-1" %>

    <% if game.persisted? && game.cover_image.attached? %>
      <div class="mb-3 bg-white p-3 rounded border border-gray-300">
        <p class="text-xs text-gray-600 mb-2 font-semibold">現在の画像:</p>
        <%= image_tag game.cover_image,
              class: "rounded border border-gray-300 shadow mb-2 mx-auto",
              style: "max-width: 250px;" %>

        <div class="mt-2 flex items-center justify-center">
          <%= f.check_box :remove_cover_image, class: "mr-1 w-3 h-3" %>
          <%= f.label :remove_cover_image, "この画像を削除",
                class: "text-sm text-red-600 font-semibold cursor-pointer" %>
        </div>
      </div>
    <% end %>

    <!-- ファイル選択 -->
    <div class="border-2 border-dashed border-gray-400 rounded p-4 text-center bg-white hover:bg-gray-50 transition">
      <%= f.file_field :cover_image,
            accept: "image/png,image/jpeg,image/gif,image/webp",
            class: "block w-full text-sm text-gray-600
                    file:mr-3 file:py-2 file:px-4
                    file:rounded file:border-0
                    file:text-sm file:font-bold
                    file:bg-blue-600 file:text-white
                    hover:file:bg-blue-700
                    file:cursor-pointer cursor-pointer",
            id: "cover_image_input" %>

      <p class="text-sm text-gray-500 mt-2">
        PNG, JPG, GIF, WebP (最大5MB)
      </p>
    </div>

    <!-- プレビュー表示エリア -->
    <div id="image-preview"
         class="mt-3 bg-white p-3 rounded border border-gray-300"
         style="display: none;">
      <p class="text-xl text-gray-600 mb-2 font-semibold">プレビュー:</p>
      <img id="preview-img"
           src=""
           class="rounded border border-gray-300 shadow max-w-xs mx-auto">
    </div>
  </div>

  <!-- 保存ボタン -->
  <div class="flex justify-center gap-4 mt-6">
    <%= link_to "CANCEL", dashboard_path,
          class: "font-pixel px-8 py-2 bg-red-600 text-white text-sm rounded hover:bg-red-700 transition" %>
    <%= f.submit "SAVE",
          class: "font-pixel px-8 py-2 bg-blue-600 text-white text-sm rounded hover:bg-blue-700 transition" %>
  </div>
<% end %>

<script>
  // IGDB検索
  function setupIgdbSearch() {
    const searchBtn = document.getElementById('search_title')
    if (!searchBtn) return

    searchBtn.addEventListener('click', function () {
      const query = document.getElementById('game_title').value.trim()
      if (!query) return

      const resultsBox = document.getElementById('igdb-results')
      resultsBox.innerHTML = '<p class="p-4 text-sm text-gray-500 text-center">検索中...</p>'
      resultsBox.style.display = 'block'

      fetch(`/games/igdb_search?q=${encodeURIComponent(query)}`)
        .then(response => response.text())
        .then(html => {
          resultsBox.innerHTML = html

          resultsBox.querySelectorAll('.igdb-select-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
              const title = btn.dataset.title
              const cover = btn.dataset.cover || ''

              // フォームにセット
              document.getElementById('game_title').value = title
              document.getElementById('igdb_cover_url').value = cover

              // 選択プレビューを表示
              const preview = document.getElementById('igdb-selected-preview')
              document.getElementById('igdb-selected-name').textContent = title
              const previewImg = document.getElementById('igdb-selected-img')
              if (cover) {
                previewImg.src = cover
                previewImg.style.display = 'block'
              } else {
                previewImg.style.display = 'none'
              }
              preview.classList.remove('hidden')

              // 結果を閉じる
              resultsBox.style.display = 'none'
              resultsBox.innerHTML = ''
            })
          })
        })
    })

    // クリアボタン
    const clearBtn = document.getElementById('igdb-clear-btn')
    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        document.getElementById('igdb_cover_url').value = ''
        document.getElementById('igdb-selected-preview').classList.add('hidden')
      })
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    setupImagePreview();
    setupMateriaRating();
    setupIgdbSearch();
  });

  document.addEventListener('turbo:load', function () {
    setupImagePreview();
    setupMateriaRating();
    setupIgdbSearch();
  });

  // 画像プレビュー
  function setupImagePreview() {
    const fileInput = document.getElementById('cover_image_input');
    const previewContainer = document.getElementById('image-preview');
    const previewImg = document.getElementById('preview-img');

    if (!fileInput || !previewContainer || !previewImg) {
      return;
    }

    fileInput.addEventListener('change', function (event) {
      const file = event.target.files[0];

      if (file && file.type.startsWith('image/')) {
        const reader = new FileReader();

        reader.onload = function (e) {
          previewImg.src = e.target.result;
          previewContainer.style.display = 'block';
        };

        reader.readAsDataURL(file);
      } else {
        previewContainer.style.display = 'none';
      }
    });
  }

  // マテリアル評価システム
  function setupMateriaRating() {
    // 既存の値を反映
    const currentFun = document.querySelector('input[name="game[fun]"]:checked');
    const currentDifficulty = document.querySelector('input[name="game[difficulty]"]:checked');
    
    if (currentFun) {
      updateMaterias('fun', parseInt(currentFun.value));
    }
    
    if (currentDifficulty) {
      updateMaterias('difficulty', parseInt(currentDifficulty.value));
    }
    
    // マテリアルクリック時の処理
    document.querySelectorAll('.materia').forEach(materia => {
      materia.parentElement.addEventListener('click', function(e) {
        e.preventDefault();
        const rating = parseInt(materia.dataset.rating);
        const type = materia.dataset.type;
        
        // 常に選択状態にする（解除しない）
        document.getElementById(`${type}_${rating}`).checked = true;
        updateMaterias(type, rating);
      });
    });
  }
  
  // マテリアルの表示を更新
  function updateMaterias(type, rating) {
    document.querySelectorAll(`.materia[data-type="${type}"]`).forEach(m => {
      const mRating = parseInt(m.dataset.rating);
      if (mRating <= rating) {
        m.classList.remove('inactive');
      } else {
        m.classList.add('inactive');
      }
    });
  }



</script>