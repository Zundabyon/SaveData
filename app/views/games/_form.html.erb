<%= form_with model: game, local: true, html: { multipart: true } do |f| %>

  <!-- エラー表示 -->
  <% if game.errors.any? %>
    <div class="mb-4 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg">
      <p class="font-bold text-sm">
        入力内容に<%= game.errors.count %>件のエラーがあります
      </p>
      <ul class="list-disc list-inside mt-2 text-xs">
        <% game.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

<!-- タイトル -->
<div class="mb-4">
  <%= f.label :title, "ゲーム選択",
        class: "block text-xl font-bold text-gray-800 mb-1" %>
  
  <!-- 入力欄とボタンを横並びに -->
  <div class="flex gap-1 sm:gap-2 items-start">
    <%= f.text_field :title, placeholder: "例: ファイナルファンタジーVII",
          class: "flex-1 min-w-0 px-2 py-2 sm:px-3 sm:py-3 bg-white border border-gray-400 rounded text-sm focus:outline-none focus:ring-1 focus:ring-blue-500" %>
    
    <!-- スマホ用：アイコンのみ -->
    <button type="button" id="search_title"
            class="flex-shrink-0 inline-flex items-center justify-center
                   px-3 py-2
                   bg-blue-500 hover:bg-blue-600 rounded border border-gray-400 
                   transition text-white text-sm font-bold
                   sm:hidden"
            style="min-width: 44px; min-height: 44px;"
            title="検索">
      <%= image_tag 'search.gif', alt: '検索', class: 'w-5 h-5' %>
    </button>
    
    <!-- デスクトップ用：アイコン+テキスト -->
    <button type="button" id="search_title_desktop"
            class="hidden sm:inline-flex flex-shrink-0 items-center justify-center gap-2
                   px-4 py-2.5 sm:px-5 sm:py-3
                   bg-blue-500 hover:bg-blue-600 rounded border border-gray-400 
                   transition text-white text-sm font-bold"
            style="min-height: 44px;">
      <%= image_tag 'search.gif', alt: '検索', class: 'w-5 h-5' %>
      <span>検索</span>
    </button>
  </div>
  
  <p class="text-xs text-gray-600 mt-1">
    💡 英語タイトルで検索すると、より多くの結果が見つかります！<br>
    例: "Final Fantasy" や "The Legend of Zelda"
  </p>
</div>

    <!-- IGDB検索結果 -->
  <div id="igdb-results"
       class="mt-2 border border-gray-300 rounded bg-white max-h-96 overflow-y-auto"
       style="display: none;">
  </div>

  <!-- 選択したゲームのプレビュー -->
  <div id="igdb-selected-preview" class="mt-2 hidden">
    <div class="flex items-center gap-3 p-2 bg-blue-50 border border-blue-300 rounded">
      <img id="igdb-selected-img" src="" class="w-12 h-16 object-cover rounded border border-blue-300" alt="">
      <div class="flex-1">
        <p class="text-xs text-blue-500 font-semibold">IGDBから選択中</p>
        <p id="igdb-selected-name" class="text-sm font-bold text-gray-800"></p>
      </div>
      <button type="button" id="igdb-clear-btn" class="text-xs text-red-500 hover:underline">クリア</button>
    </div>
  </div>

  <!-- igdb APIで取得した画像を隠して入れておく場所 -->
  <%= f.hidden_field :igdb_cover_url, id: "igdb_cover_url" %>


  <!-- ハードとジャンルを横並び -->
  <div class="grid grid-cols-2 gap-3 mb-4">
    <!-- ゲーム機 -->
    <div>
      <%= f.label :hardware, "遊んだゲーム機",
            class: "block text-xl font-bold text-gray-800 mb-1" %>
      <%= f.grouped_collection_select :hardware,
            Game::HARDWARE_GROUPED, :last, :first, :itself, :itself,
            { include_blank: "-- 選択 --" },
            class: "w-full px-3 py-2 bg-white border border-gray-400 rounded text-sm" %>
    </div>

    <!-- ジャンル -->
    <div>
      <%= f.label :genre, "ジャンル",
            class: "block text-xl font-bold text-gray-800 mb-1" %>
      <%= f.select :genre,
            Game::GENRE_OPTIONS,
            { include_blank: "-- 選択 --" },
            class: "w-full px-3 py-2 bg-white border border-gray-400 rounded text-sm" %>
    </div>
  </div>

  <!-- プレイした年齢 -->
  <div class="mb-4">
    <%= f.label :played_age, "何歳くらいにプレイした？",
          class: "block text-xl font-bold text-gray-800 mb-1" %>
    <%= f.select :played_age,
          Game::PLAYED_AGE_OPTIONS.map { |label, value| [label, value] },
          { include_blank: "-- 選択 --", selected: game.played_age || Game::PLAYED_AGE_OPTIONS.first[1] },
          class: "w-full px-3 py-2 bg-white border border-gray-400 rounded text-sm" %>
  </div>

<!-- 評価を横並び -->
  <div class="grid grid-cols-2 gap-4 mb-4">
    <!-- ゲームの楽しさ -->
    <div class="bg-white p-3 rounded border border-gray-300">
      <p class="text-xl font-bold text-gray-800 mb-2 text-center">楽しさ</p>
      <div class="flex flex-row-reverse justify-center gap-1">
        <% 5.downto(1) do |i| %>
          <%= f.radio_button :fun, i, id: "fun_#{i}", class: "hidden" %>
          <label for="fun_<%= i %>" class="cursor-pointer">
            <span class="materia materia-green inline-block <%= 'inactive' unless game.fun && game.fun >= i %>" 
                  data-rating="<%= i %>"
                  data-type="fun"></span>
          </label>
        <% end %>
      </div>
      <p class="text-xs text-center mt-2 text-gray-600">クリックで選択</p>
    </div>

    <!-- ゲームの難しさ -->
    <div class="bg-white p-3 rounded border border-gray-300">
      <p class="text-xl font-bold text-gray-800 mb-2 text-center">難しさ</p>
      <div class="flex flex-row-reverse justify-center gap-1">
        <% 5.downto(1) do |i| %>
          <%= f.radio_button :difficulty, i, id: "difficulty_#{i}", class: "hidden" %>
          <label for="difficulty_<%= i %>" class="cursor-pointer">
            <span class="materia materia-red inline-block <%= 'inactive' unless game.difficulty && game.difficulty >= i %>" 
                  data-rating="<%= i %>"
                  data-type="difficulty"></span>
          </label>
        <% end %>
      </div>
      <p class="text-xs text-center mt-2 text-gray-600">クリックで選択</p>
    </div>
  </div>

  <!-- メモ -->
  <div class="mb-4">
    <%= f.label :memo, "ひとことメモ ※150文字以内",
          class: "block text-xl font-bold text-gray-800 mb-1" %>
    <%= f.text_area :memo,
          rows: 3,
          maxlength: 150,
          placeholder: "当時の感想や思い出を自由に...",
          class: "w-full px-3 py-2 bg-white border border-gray-400 rounded text-sm",
          onkeyup: "ShowLength(this.value);" %>
    <p id="inputlength" class="text-xs text-gray-600 mt-1">0文字</p>
  </div>

  <!-- カバー画像 -->
  <div class="mb-5">
    <%= f.label :cover_image, "カバー画像を自分で入れたい方はこちら",
          class: "block text-xl font-bold text-gray-800 mb-1" %>

    <% if game.persisted? && game.cover_image.attached? %>
      <div class="mb-3 bg-white p-3 rounded border border-gray-300">
        <p class="text-xs text-gray-600 mb-2 font-semibold">現在の画像:</p>
        <%= image_tag game.cover_image,
              class: "rounded border border-gray-300 shadow mb-2 mx-auto",
              style: "max-width: 250px;" %>

        <div class="mt-2 flex items-center justify-center">
          <%= f.check_box :remove_cover_image, class: "mr-1 w-3 h-3" %>
          <%= f.label :remove_cover_image, "この画像を削除",
                class: "text-sm text-red-600 font-semibold cursor-pointer" %>
        </div>
      </div>
    <% end %>

    <!-- ファイル選択 -->
    <div class="border-2 border-dashed border-gray-400 rounded p-4 text-center bg-white hover:bg-gray-50 transition">
      <%= f.file_field :cover_image,
            accept: "image/png,image/jpeg,image/gif,image/webp",
            class: "block w-full text-sm text-gray-600
                    file:mr-3 file:py-2 file:px-4
                    file:rounded file:border-0
                    file:text-sm file:font-bold
                    file:bg-blue-600 file:text-white
                    hover:file:bg-blue-700
                    file:cursor-pointer cursor-pointer",
            id: "cover_image_input" %>

      <p class="text-sm text-gray-500 mt-2">
        PNG, JPG, GIF, WebP (最大5MB)
      </p>
    </div>

    <!-- プレビュー表示エリア -->
    <div id="image-preview"
         class="mt-3 bg-white p-3 rounded border border-gray-300"
         style="display: none;">
      <p class="text-xl text-gray-600 mb-2 font-semibold">プレビュー:</p>
      <img id="preview-img"
           src=""
           class="rounded border border-gray-300 shadow max-w-xs mx-auto">
    </div>
  </div>

  <!-- 保存ボタン -->
  <div class="flex justify-center gap-4 mt-6">
    <%= link_to "CANCEL", dashboard_path,
          class: "font-pixel px-8 py-2 bg-red-600 text-white text-sm rounded hover:bg-red-700 transition" %>
    <%= f.submit "SAVE",
          class: "font-pixel px-8 py-2 bg-blue-600 text-white text-sm rounded hover:bg-blue-700 transition" %>
  </div>
<% end %>

<script>
  // IGDBプラットフォーム名をハードウェア選択肢にマッピング
  function mapIgdbPlatformToHardware(igdbPlatform) {
    const platformMap = {
      // Nintendo
      'Nintendo Switch': 'Nintendo Switch',
      'Nintendo 3DS': 'Nintendo 3DS',
      'Nintendo DS': 'Nintendo DS',
      'Wii U': 'Wii',
      'Wii': 'Wii',
      'GameCube': 'ゲームキューブ',
      'Nintendo 64': 'ニンテンドー64',
      'SNES': 'スーパーファミコン',
      'NES': 'ファミコン',
      'Game Boy Advance': 'ゲームボーイアドバンス',
      'Game Boy Color': 'ゲームボーイ',
      'Game Boy': 'ゲームボーイ',
      
      // PlayStation
      'PlayStation 5': 'プレステ５',
      'PlayStation 4': 'プレステ４',
      'PlayStation 3': 'プレステ３',
      'PlayStation 2': 'プレステ２',
      'PlayStation': 'プレステ',
      'PlayStation Vita': 'PS Vita',
      'PSP': 'PSP',
      
      // Sega
      'Sega Saturn': 'セガサターン',
      'Sega Mega Drive/Genesis': 'メガドライブ',
      
      // Other
      'PC': 'PC',
      'Android': 'スマートフォン',
      'iOS': 'スマートフォン',
      'Arcade': 'アーケード機',
      'Neo Geo': 'ネオジオ'
    };
    
    return platformMap[igdbPlatform] || null;
  }

  // IGDBジャンル名をジャンル選択肢にマッピング
  function mapIgdbGenreToGenre(igdbGenre) {
    const genreMap = {
      'Role-playing (RPG)': 'RPG',
      'Action': 'アクション',
      'Adventure': 'アドベンチャー',
      'Shooter': 'シューティング',
      'Fighting': '格闘',
      'Sport': 'スポーツ',
      'Racing': 'スポーツ',
      'shooter': 'シューティング',
      'Strategy': 'ストラテジー',
      'Puzzle': 'パズル',
      'Platform': 'アクション',
      'Simulator': 'シミュレーション',
      'Indie': 'その他',
      'Arcade': 'アクション',
      'Visual Novel': 'ノベル',
      'Card & Board Game': 'ボードゲーム',
      'MOBA': 'アクション',
      'Point-and-click': 'アドベンチャー',
      'Tactical': 'ストラテジー',
      'Hack and slash': 'アクション',
      'Quiz/Trivia': 'パズル',
      'Pinball': 'アクション',
      'Music': 'その他'
    };
    
    return genreMap[igdbGenre] || null;
  }

// IGDB検索
function setupIgdbSearch() {
  console.log('Setting up IGDB search...');
  
  const searchBtnMobile = document.getElementById('search_title');
  const searchBtnDesktop = document.getElementById('search_title_desktop');
  
  if (searchBtnMobile) {
    searchBtnMobile.removeEventListener('click', handleIgdbSearchClick);
    searchBtnMobile.addEventListener('click', handleIgdbSearchClick);
  }
  
  if (searchBtnDesktop) {
    searchBtnDesktop.removeEventListener('click', handleIgdbSearchClick);
    searchBtnDesktop.addEventListener('click', handleIgdbSearchClick);
  }
}
  
  // IGDB検索のクリックハンドラー関数
  function handleIgdbSearchClick() {
    console.log('IGDB search button clicked');
    
    const query = document.getElementById('game_title').value.trim();
    console.log('Search query:', query);
    
    if (!query) {
      alert('タイトルを入力してください');
      return;
    }

    const resultsBox = document.getElementById('igdb-results');
    if (!resultsBox) {
      console.error('Results box not found');
      return;
    }
    
    resultsBox.innerHTML = '<p class="p-4 text-sm text-gray-500 text-center">検索中...</p>';
    resultsBox.style.display = 'block';

    console.log('Sending fetch request to:', `/games/igdb_search?q=${encodeURIComponent(query)}`);
    
    // CSRFトークンを取得
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
    console.log('CSRF token:', csrfToken ? 'found' : 'not found');
    
    fetch(`/games/igdb_search?q=${encodeURIComponent(query)}`, {
      method: 'GET',
      headers: {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
        'X-CSRF-Token': csrfToken || ''
      },
      signal: AbortSignal.timeout(10000) // 10秒タイムアウト
    })
      .then(response => {
        console.log('Fetch response status:', response.status);
        console.log('Fetch response ok:', response.ok);
        
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.text();
      })
      .then(html => {
        console.log('Received HTML response, length:', html.length);
        resultsBox.innerHTML = html;

        // 選択ボタンにイベントリスナーを設定
        resultsBox.querySelectorAll('.igdb-select-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            const title = btn.dataset.title;
            const cover = btn.dataset.cover || '';
            const platforms = btn.dataset.platforms ? JSON.parse(btn.dataset.platforms) : [];
            const genres = btn.dataset.genres ? JSON.parse(btn.dataset.genres) : [];

            // フォームにセット
            const titleInput = document.getElementById('game_title');
            if (titleInput) titleInput.value = title;
            
            const coverInput = document.getElementById('igdb_cover_url');
            if (coverInput) coverInput.value = cover;

            // プラットフォームをマッピングしてセット
            const hardwareSelect = document.getElementById('game_hardware');
            if (hardwareSelect && platforms.length > 0) {
              const mappedHardware = mapIgdbPlatformToHardware(platforms[0].name);
              if (mappedHardware) {
                hardwareSelect.value = mappedHardware;
              }
            }

            // ジャンルをマッピングしてセット
            const genreSelect = document.getElementById('game_genre');
            if (genreSelect && genres.length > 0) {
              const mappedGenre = mapIgdbGenreToGenre(genres[0].name);
              if (mappedGenre) {
                genreSelect.value = mappedGenre;
              }
            }

            // 画像プレビューを表示（IGDB画像の場合）
            if (cover) {
              const previewContainer = document.getElementById('image-preview');
              const previewImg = document.getElementById('preview-img');
              if (previewContainer && previewImg) {
                previewImg.src = cover;
                previewContainer.style.display = 'block';
              }
              // IGDB画像を選択した場合はファイル入力をクリア
              const fileInput = document.getElementById('cover_image_input');
              if (fileInput) fileInput.value = '';
            }

            // 結果を閉じる
            resultsBox.style.display = 'none';
            resultsBox.innerHTML = '';
          });
        });
      })
      .catch(error => {
        console.error('IGDB search error:', error);
        resultsBox.innerHTML = '<p class="p-4 text-sm text-red-500 text-center">検索に失敗しました: ' + error.message + '</p>';
      });
  }
  // クリアボタンの処理もイベント委譲に
  function setupIgdbClear() {
    const clearBtn = document.getElementById('igdb-clear-btn');
    if (!clearBtn) return;
    
    // 既存のリスナーを削除
    clearBtn.removeEventListener('click', handleIgdbClearClick);
    clearBtn.addEventListener('click', handleIgdbClearClick);
  }
  
  function handleIgdbClearClick() {
    console.log('IGDB clear button clicked');
    
    const coverInput = document.getElementById('igdb_cover_url');
    if (coverInput) coverInput.value = '';
    
    // プラットフォームとジャンルの選択もクリア
    const hardwareSelect = document.getElementById('game_hardware');
    if (hardwareSelect) hardwareSelect.value = '';
    
    const genreSelect = document.getElementById('game_genre');
    if (genreSelect) genreSelect.value = '';
    
    const preview = document.getElementById('igdb-selected-preview');
    if (preview) preview.classList.add('hidden');
    
    // 画像プレビューも非表示
    const imagePreview = document.getElementById('image-preview');
    if (imagePreview) imagePreview.style.display = 'none';
  }

  document.addEventListener('DOMContentLoaded', function () {
    setupImagePreview();
    setupMateriaRating();
    setupIgdbSearch();
    setupIgdbClear();
  });

  document.addEventListener('turbo:load', function () {
    setupImagePreview();
    setupMateriaRating();
    setupIgdbSearch();
    setupIgdbClear();
  });

  // 画像プレビュー
  function setupImagePreview() {
    const fileInput = document.getElementById('cover_image_input');
    const previewContainer = document.getElementById('image-preview');
    const previewImg = document.getElementById('preview-img');

    if (!fileInput || !previewContainer || !previewImg) {
      return;
    }

    fileInput.addEventListener('change', function (event) {
      const file = event.target.files[0];

      if (file && file.type.startsWith('image/')) {
        const reader = new FileReader();

        reader.onload = function (e) {
          previewImg.src = e.target.result;
          previewContainer.style.display = 'block';
          
          // ファイルを選択した場合はIGDB関連のフィールドをクリア
          const coverInput = document.getElementById('igdb_cover_url');
          if (coverInput) coverInput.value = '';
          
          const igdbPreview = document.getElementById('igdb-selected-preview');
          if (igdbPreview) igdbPreview.classList.add('hidden');
        };

        reader.readAsDataURL(file);
      } else {
        previewContainer.style.display = 'none';
      }
    });
  }

  // マテリアル評価システム
  function setupMateriaRating() {
    console.log('Setting up materia rating...');
    
    // 既存の値を反映
    const currentFun = document.querySelector('input[name="game[fun]"]:checked');
    const currentDifficulty = document.querySelector('input[name="game[difficulty]"]:checked');
    
    if (currentFun) {
      updateMaterias('fun', parseInt(currentFun.value));
    }
    
    if (currentDifficulty) {
      updateMaterias('difficulty', parseInt(currentDifficulty.value));
    }
    
    // マテリアルクリック時の処理 - 各要素に直接設定
    document.querySelectorAll('.materia').forEach(materia => {
      // 既存のリスナーを削除（重複防止）
      materia.parentElement.removeEventListener('click', handleMateriaClick);
      materia.parentElement.addEventListener('click', handleMateriaClick);
    });
  }
  
  // マテリアルクリックのハンドラー関数
  function handleMateriaClick(e) {
    e.preventDefault();
    const materia = e.target.closest('.materia');
    if (!materia) return;
    
    console.log('Materia clicked:', materia.dataset);
    
    const rating = parseInt(materia.dataset.rating);
    const type = materia.dataset.type;
    
    // 常に選択状態にする（解除しない）
    const radio = document.getElementById(`${type}_${rating}`);
    if (radio) {
      radio.checked = true;
      updateMaterias(type, rating);
    }
  }
  
  // マテリアルの表示を更新
  function updateMaterias(type, rating) {
    document.querySelectorAll(`.materia[data-type="${type}"]`).forEach(m => {
      const mRating = parseInt(m.dataset.rating);
      if (mRating <= rating) {
        m.classList.remove('inactive');
      } else {
        m.classList.add('inactive');
      }
    });
  }
  // メモの文字数表示
  function ShowLength( str ) {
    document.getElementById("inputlength").innerHTML = str.length + "文字";
  }

</script>