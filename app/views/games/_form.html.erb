<%= form_with model: game, local: true, html: { multipart: true } do |f| %>
  <!-- エラー表示 -->
  <% if game.errors.any? %>
    <div class="mb-4 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg">
      <p class="font-bold text-sm">
        入力内容に<%= game.errors.count %>件のエラーがあります
      </p>
      <ul class="list-disc list-inside mt-2 text-xs">
        <% game.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- タイトル -->
  <div class="mb-4">
    <%= f.label :title, "ゲームタイトル",
          class: "block text-xl font-bold text-gray-800 mb-1" %>
    <%= f.text_field :title,
          class: "w-full px-3 py-2 bg-white border border-gray-400 rounded text-sm focus:outline-none focus:ring-1 focus:ring-blue-500" %>
  </div>

  <!-- ハードとジャンルを横並び -->
  <div class="grid grid-cols-2 gap-3 mb-4">
    <!-- ハード -->
    <div>
      <%= f.label :hardware, "ハード",
            class: "block text-xl font-bold text-gray-800 mb-1" %>
      <%= f.text_field :hardware,
            placeholder: "PS / SFC など",
            class: "w-full px-3 py-2 bg-white border border-gray-400 rounded text-sm" %>
    </div>

    <!-- ジャンル -->
    <div>
      <%= f.label :genre, "ジャンル",
            class: "block text-xl font-bold text-gray-800 mb-1" %>
      <%= f.text_field :genre,
            class: "w-full px-3 py-2 bg-white border border-gray-400 rounded text-sm" %>
    </div>
  </div>

  <!-- プレイした年齢 -->
  <div class="mb-4">
    <%= f.label :played_age, "何歳くらいにプレイした？",
          class: "block text-xl font-bold text-gray-800 mb-1" %>
    <%= f.number_field :played_age,
          placeholder: "例: 15",
          class: "w-full px-3 py-2 bg-white border border-gray-400 rounded text-sm" %>
  </div>

  <!-- 評価を横並び -->
  <div class="grid grid-cols-2 gap-4 mb-4">
    <!-- ゲームの楽しさ -->
    <div class="bg-white p-3 rounded border border-gray-300">
      <p class="text-xl font-bold text-gray-800 mb-2 text-center">楽しさ</p>
      <div class="flex flex-row-reverse justify-center gap-1">
        <% 10.downto(1) do |i| %>
          <%= f.radio_button :fun, i, id: "fun_#{i}", class: "hidden peer" %>
          <label for="fun_<%= i %>"
                 class="cursor-pointer text-gray-300 peer-checked:text-yellow-400 text-xl transition-all hover:scale-110">
            ★
          </label>
        <% end %>
      </div>
    </div>

    <!-- ゲームの難しさ -->
    <div class="bg-white p-3 rounded border border-gray-300">
      <p class="text-xl font-bold text-gray-800 mb-2 text-center">難しさ</p>
      <div class="flex flex-row-reverse justify-center gap-1">
        <% 10.downto(1) do |i| %>
          <%= f.radio_button :difficulty, i, id: "difficulty_#{i}", class: "hidden peer" %>
          <label for="difficulty_<%= i %>"
                 class="cursor-pointer text-gray-300 peer-checked:text-red-500 text-xl transition-all hover:scale-110">
            ★
          </label>
        <% end %>
      </div>
    </div>
  </div>

  <!-- メモ -->
  <div class="mb-4">
    <%= f.label :memo, "ひとことメモ ※150文字以内",
          class: "block text-xl font-bold text-gray-800 mb-1" %>
    <%= f.text_area :memo,
          rows: 3,
          placeholder: "当時の感想や思い出を自由に...",
          class: "w-full px-3 py-2 bg-white border border-gray-400 rounded text-sm" %>
  </div>

  <!-- カバー画像 -->
  <div class="mb-5">
    <%= f.label :cover_image, "カバー画像",
          class: "block text-xl font-bold text-gray-800 mb-1" %>

    <!-- 既存画像の表示 -->
    <% if game.persisted? && game.cover_image.attached? %>
      <div class="mb-3 bg-white p-3 rounded border border-gray-300">
        <p class="text-xs text-gray-600 mb-2 font-semibold">現在の画像:</p>
        <%= image_tag game.cover_image.variant(resize_to_limit: [250, 250]),
              class: "rounded border border-gray-300 shadow mb-2 mx-auto" %>

        <div class="mt-2 flex items-center justify-center">
          <%= f.check_box :remove_cover_image, class: "mr-1 w-3 h-3" %>
          <%= f.label :remove_cover_image, "この画像を削除",
                class: "text-sm text-red-600 font-semibold cursor-pointer" %>
        </div>
      </div>
    <% end %>

    <!-- ファイル選択 -->
    <div class="border-2 border-dashed border-gray-400 rounded p-4 text-center bg-white hover:bg-gray-50 transition">
      <%= f.file_field :cover_image,
            accept: "image/png,image/jpeg,image/gif,image/webp",
            class: "block w-full text-sm text-gray-600
                    file:mr-3 file:py-2 file:px-4
                    file:rounded file:border-0
                    file:text-sm file:font-bold
                    file:bg-blue-600 file:text-white
                    hover:file:bg-blue-700
                    file:cursor-pointer cursor-pointer",
            id: "cover_image_input" %>

      <p class="text-sm text-gray-500 mt-2">
        PNG, JPG, GIF, WebP (最大5MB)
      </p>
    </div>

    <!-- プレビュー表示エリア -->
    <div id="image-preview"
         class="mt-3 bg-white p-3 rounded border border-gray-300"
         style="display: none;">
      <p class="text-xl text-gray-600 mb-2 font-semibold">プレビュー:</p>
      <img id="preview-img"
           src=""
           class="rounded border border-gray-300 shadow max-w-xs mx-auto">
    </div>
  </div>

  <!-- 保存ボタン -->
  <div class="flex justify-center gap-4 mt-6">
    <%= link_to "CANCEL", dashboard_path,
          class: "font-pixel px-8 py-2 bg-red-600 text-white text-sm rounded hover:bg-red-700 transition" %>
    <%= f.submit "SAVE",
          class: "font-pixel px-8 py-2 bg-blue-600 text-white text-sm rounded hover:bg-blue-700 transition" %>
  </div>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    setupImagePreview();
  });

  document.addEventListener('turbo:load', function () {
    setupImagePreview();
  });

  function setupImagePreview() {
    const fileInput = document.getElementById('cover_image_input');
    const previewContainer = document.getElementById('image-preview');
    const previewImg = document.getElementById('preview-img');

    if (!fileInput || !previewContainer || !previewImg) {
      return;
    }

    fileInput.addEventListener('change', function (event) {
      const file = event.target.files[0];

      if (file && file.type.startsWith('image/')) {
        const reader = new FileReader();

        reader.onload = function (e) {
          previewImg.src = e.target.result;
          previewContainer.style.display = 'block';
        };

        reader.readAsDataURL(file);
      } else {
        previewContainer.style.display = 'none';
      }
    });
  }
</script>
