<% if games.empty? %>
  <p class="p-4 text-sm text-gray-500 text-center">ゲームが見つかりませんでした</p>
<% else %>
  <div class="grid grid-cols-3 gap-3 p-3">
    <% games.each do |game| %>
      <button type="button"
              class="igdb-select-btn group flex flex-col items-center text-left rounded border border-gray-200 hover:border-blue-400 hover:bg-blue-50 transition overflow-hidden"
              data-title="<%= game["name"] %>"
              data-cover="<%= game["cover_url"] %>">
        <% if game["cover_url"] %>
          <img src="<%= game["cover_url"] %>"
               class="w-full aspect-[3/4] object-cover"
               alt="<%= game["name"] %>">
        <% else %>
          <div class="w-full aspect-[3/4] bg-gray-200 flex items-center justify-center">
            <span class="text-xs text-gray-400">No Image</span>
          </div>
        <% end %>
        <p class="w-full px-1 py-1 text-xs font-bold text-gray-700 group-hover:text-blue-700 leading-tight line-clamp-2">
          <%= game["name"] %>
        </p>
      </button>
    <% end %>
  </div>
<% end %>
