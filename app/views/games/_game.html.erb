<div class="relative pl-12 pb-12 cursor-pointer"
    
    
    
    
    
    
    
    >
  
  <!-- 年齢マーカー（黄色マテリア・大きめ） -->
  <div class="absolute left-0 top-0 w-12 h-12 -ml-6 rounded-full
              border-4 border-slate-900
              flex items-center justify-center
              text-base font-bold
              year-marker">
    <%= game.played_age %>
  </div>

  <!-- カード本体 -->
  <div class="rpg-side-window rounded-lg p-6
              hover:border-cyan-500/50 hover:shadow-lg hover:shadow-cyan-500/20
              transition-all duration-300">

    <h3 class="text-xl font-bold mb-3 text-cyan-100 tracking-wider">
      <%= game.title %>
    </h3>

    <div class="flex gap-4 text-sm text-slate-300 mb-4">
      <span><%= game.hardware %></span>
      <span class="text-slate-500">|</span>
      <span><%= game.genre %></span>
    </div>

    <!-- マテリア表示 -->
    <div class="flex gap-4 items-center">
      <!-- 難易度（赤） -->
      <div class="flex items-center gap-2">
        <span class="text-xs text-slate-400">難易度</span>
        <div class="flex gap-1">
          <% 5.times do |i| %>
            <div class="materia materia-red <%= i < (game.difficulty || 0) ? '' : 'inactive' %>"></div>
          <% end %>
        </div>
      </div>

      <!-- 面白さ（緑） -->
      <div class="flex items-center gap-2">
        <span class="text-xs text-slate-400">面白さ</span>
        <div class="flex gap-1">
          <% 5.times do |i| %>
            <div class="materia materia-green <%= i < (game.fun || 0) ? '' : 'inactive' %>"></div>
          <% end %>
        </div>
      </div>
    </div>

    <% if game.memo.present? %>
      <p class="mt-4 text-sm text-slate-400 line-clamp-2">
        <%= game.memo.truncate(100) %>
      </p>
    <% end %>
  </div>
</div>