<style>
  html, body {
    background-color: #0b0f2a !important;
    margin: 0;
    height: 100%;
  }
</style>

<div class="fixed inset-0 z-50
            bg-[#0b0f2a]
            flex items-center justify-center">

  <div class="w-full max-w-2xl
              bg-[#0b0f2a]/90 backdrop-blur
              border border-slate-700 rounded-xl
              shadow-[0_0_30px_rgba(80,120,255,0.35)]
              px-10 py-8 space-y-8">

    <h2 class="text-2xl text-center tracking-widest text-blue-100">
      「<%= @game.title %>」を削除しますか？
    </h2>

<div class="flex justify-center gap-6 pt-6">
  <%= link_to "キャンセル",
        dashboard_path,
        class: "rpg-command w-48 text-center" %>

  <%= link_to "さくじょ",
        game_path(@game),
        data: { turbo_method: :delete },
        class: "rpg-command w-48 text-center bg-red-700" %>
</div>


  </div>
</div>
