  <!-- フッター -->
  <% if user_signed_in? %>
  <%
    job_images = {
      "せんし" => "warrior.png", "まほうつかい" => "mage.png",
      "とうぞく" => "thief.png", "そうりょ" => "priest.png",
      "ゆうしゃ" => "fighter.png", "しにがみ" => "devil.png",
      "Figmaしょくにん" => "figma_master.png", "ロブスター" => "lobster.png",
      "その他" => "other.png",
      "warrior" => "warrior.png", "mage" => "mage.png",
      "thief" => "thief.png", "priest" => "priest.png",
      "fighter" => "fighter.png", "devil" => "devil.png",
      "figma_master" => "figma_master.png", "lobster" => "lobster.png",
      "other" => "other.png"
    }

    job_image = job_images[current_user.job] || "other.png"
  %>

  <div class="fixed bottom-0 left-0 right-0 z-50 rpg-side-window px-2 py-2 flex justify-around items-center footer-container gap-3 pointer-events-none">

    <!-- アバター -->
    <div class="footer-avatar pointer-events-auto">
      <%= link_to user_path(current_user) do %>
        <%= image_tag "jobs/#{job_image}",
          class: "footer-avatar-img",
          alt: current_user.job %>
      <% end %>
    </div>

    <!-- ボタン -->
    <%= link_to "ダッシュボードへ", dashboard_path,
        class: "rpg-command footer-btn pointer-events-auto" %>

    <%= link_to "冒険を共有",
        "https://twitter.com/intent/tweet?text=SaveData+あの頃遊んだゲームの思い出を記録しよう&url=https://savedata-app.onrender.com/",
        target: "_blank", rel: "noopener",
        class: "rpg-command footer-btn pointer-events-auto" %>

    <button id="hamburger-btn"
            onclick="toggleHamburger()"
            class="rpg-command footer-btn pointer-events-auto">
      メニュー
    </button>

    <!-- ハンバーガーメニュー -->
    <div id="hamburger-menu"
        class="absolute right-0 rpg-side-window rounded-2xl z-50 menu-wipe hamburger-menu pointer-events-auto">

      <div class="px-4 py-3 border-b border-blue-400 text-center">
        <%= image_tag "jobs/#{job_image}",
              class: "profile-image object-contain mx-auto mb-2",
              alt: current_user.job || "職業未設定" %>

        <div class="text-sm text-blue-300">Lv.<%= current_user.level.presence || "1" %></div>
        <div class="text-lg font-bold text-white"><%= current_user.name.presence || "名無しの冒険者" %></div>
        <div class="text-sm text-blue-200"><%= job_hiragana(current_user.job) %></div>
      </div>

      <ul class="py-2 text-sm text-white">
        <li>
          <%= link_to "ゲーム登録", new_game_path,
                class: "block px-4 py-2 hover:bg-blue-800" %>
        </li>
        <li>
          <%= link_to "ユーザー編集", edit_user_registration_path,
                class: "block px-4 py-2 hover:bg-blue-800" %>
        </li>
        <li>
          <%= link_to "使い方", how_to_path,
                class: "block px-4 py-2 hover:bg-blue-800" %>
        </li>
        <li>
          <%= link_to "Xでシェア",
                "https://twitter.com/intent/tweet?text=SaveData+あの頃遊んだゲームの思い出を記録しよう&url=https://savedata-app.onrender.com/",
                target: "_blank", rel: "noopener",
                class: "block px-4 py-2 hover:bg-blue-800" %>
        </li>
        <li>
          <%= link_to "ログアウト", destroy_user_session_path,
                data: { turbo_method: :delete },
                class: "block px-4 py-2 hover:bg-blue-800" %>
        </li>
      </ul>

    </div>
  </div>

    <script>
      function toggleHamburger() {
        const menu = document.getElementById('hamburger-menu');
        if (menu.style.display === 'none' || menu.style.display === '') {
          menu.style.display = 'block';
          menu.classList.remove('is-closing');
          void menu.offsetWidth; // reflow
          menu.classList.add('is-open');
        } else {
          menu.classList.remove('is-open');
          menu.classList.add('is-closing');
          menu.addEventListener('animationend', function hide() {
            menu.style.display = 'none';
            menu.classList.remove('is-closing');
            menu.removeEventListener('animationend', hide);
          });
        }
      }
      document.addEventListener('click', function(e) {
        const btn = document.getElementById('hamburger-btn');
        const menu = document.getElementById('hamburger-menu');
        if (btn && menu && !btn.contains(e.target) && !menu.contains(e.target)) {
          if (menu.style.display !== 'none') {
            menu.classList.remove('is-open');
            menu.classList.add('is-closing');
            menu.addEventListener('animationend', function hide() {
              menu.style.display = 'none';
              menu.classList.remove('is-closing');
              menu.removeEventListener('animationend', hide);
            });
          }
        }
      });
  </script>

  <script>
    // フッターのレスポンシブ対応
    function updateFooterSize() {
      const isMobile = window.innerWidth < 768; // 768px未満をモバイルと判定

      if (isMobile) {
        // モバイルサイズ
        document.documentElement.style.setProperty('--footer-btn-padding-x', '0.5rem');
        document.documentElement.style.setProperty('--footer-btn-padding-y', '0.25rem');
        document.documentElement.style.setProperty('--footer-btn-font-size', '0.75rem');
        document.documentElement.style.setProperty('--footer-hamburger-padding-x', '0.5rem');
        document.documentElement.style.setProperty('--footer-hamburger-padding-y', '0.25rem');
        document.documentElement.style.setProperty('--footer-hamburger-font-size', '1rem');
        document.documentElement.style.setProperty('--hamburger-menu-width', '12rem');
        document.documentElement.style.setProperty('--profile-image-width', '6rem');
        document.documentElement.style.setProperty('--profile-image-height', '6rem');
      } else {
        // デスクトップサイズ
        document.documentElement.style.setProperty('--footer-btn-padding-x', '1rem');
        document.documentElement.style.setProperty('--footer-btn-padding-y', '0.5rem');
        document.documentElement.style.setProperty('--footer-btn-font-size', '0.875rem');
        document.documentElement.style.setProperty('--footer-hamburger-padding-x', '1rem');
        document.documentElement.style.setProperty('--footer-hamburger-padding-y', '0.5rem');
        document.documentElement.style.setProperty('--footer-hamburger-font-size', '1.125rem');
        document.documentElement.style.setProperty('--hamburger-menu-width', '18rem');
        document.documentElement.style.setProperty('--profile-image-width', '12rem');
        document.documentElement.style.setProperty('--profile-image-height', '12rem');
      }
    }

    // 初期化とリサイズ時の更新
    document.addEventListener('DOMContentLoaded', updateFooterSize);
    window.addEventListener('resize', updateFooterSize);
    document.addEventListener('turbo:load', updateFooterSize);
  </script>
<% end %>
