<!-- ヘッダー -->
<header class="bg-white shadow-sm border-b border-gray-200">
  <div class="container mx-auto px-4 py-3">
    <div class="flex items-center justify-between">
      <!-- ロゴ -->
      <div class="flex items-center">
        <%= link_to root_path, class: "text-xl font-bold text-gray-800 hover:text-blue-600 transition-colors" do %>
          <span class="text-blue-600">Save</span><span class="text-gray-600">Data</span>
        <% end %>
      </div>

      <!-- ナビゲーション -->
      <nav class="hidden md:flex items-center space-x-6">
        <% if user_signed_in? %>
          <%= link_to "ダッシュボード", root_path, class: "text-gray-600 hover:text-blue-600 transition-colors" %>
          <%= link_to "ゲーム登録", new_game_path, class: "text-gray-600 hover:text-blue-600 transition-colors" %>
          <%= link_to "使い方", how_to_path, class: "text-gray-600 hover:text-blue-600 transition-colors" %>
          <div class="flex items-center space-x-2 text-sm text-gray-600">
            <span>Lv.<%= current_user.level.presence || "1" %></span>
            <span><%= current_user.name.presence || "名無しの冒険者" %></span>
          </div>
          <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-red-600 hover:text-red-800 transition-colors" %>
        <% else %>
          <%= link_to "ログイン", new_user_session_path, class: "text-gray-600 hover:text-blue-600 transition-colors" %>
          <%= link_to "新規登録", new_user_registration_path, class: "bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors" %>
        <% end %>
      </nav>

      <!-- モバイルメニュー -->
      <div class="md:hidden">
        <% if user_signed_in? %>
          <div class="flex items-center space-x-2">
            <span class="text-sm text-gray-600">Lv.<%= current_user.level.presence || "1" %></span>
            <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "text-red-600 hover:text-red-800 text-sm" %>
          </div>
        <% else %>
          <%= link_to "ログイン", new_user_session_path, class: "text-blue-600 hover:text-blue-800 text-sm" %>
        <% end %>
      </div>
    </div>
  </div>
</header>