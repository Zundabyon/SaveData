<div class="min-h-screen flex flex-col items-center justify-start py-12 px-4">

  <%# タイトルエリア %>
  <div class="text-center mb-10">
    <h1 class="text-4xl font-bold text-white mb-4" style="text-shadow: 0 0 20px rgba(253,224,71,0.5);">
      占いおばばの部屋
    </h1>
    <%= image_tag "uranai_grandma.png", class: "mx-auto mb-4", style: "width: 600px; height: 300px;" %>
    <p class="text-blue-200 text-sm tracking-widest">
      <%= current_user.name %>よ、汝が次に出会うべきゲームを占ってしんぜよう…
    </p>
  </div>

  <%# 入力エリア %>
  <div class="w-full max-w-md mb-8">
    <div class="rounded-xl border border-blue-700 p-6 shadow-lg" style="background-color: white;">
      <label class="block text-center text-black text-sm mb-2 tracking-wider">
        ⚔️ プレイしたゲームのタイトルを入力するのじゃ
      </label>
      <input
        type="text"
        id="game-title-input"
        placeholder="例：ファイナルファンタジーⅧ"
        class="w-full bg-gray-100 text-gray-800 border border-gray-300 rounded-lg px-4 py-3 mb-4 focus:outline-none focus:border-yellow-400 placeholder-gray-400"
      >
      <button
        id="predict-btn"
        onclick="predict()"
        class="w-full bg-yellow-500 hover:bg-yellow-400 text-blue-950 font-bold py-3 rounded-lg transition-all duration-200 tracking-wider border-2 border-yellow-700 shadow-md"
      >
        🔮 占う
      </button>
    </div>
  </div>

  <%# 結果エリア %>
  <div id="result" class="w-full max-w-md" style="display:none;">
    <p class="text-center text-white text-sm tracking-widest mb-4">＊ 運命の書 ＊</p>
    <div id="result-cards" class="flex flex-col gap-4"></div>
  </div>

</div>

<script>
  async function predict() {
    const gameTitle = document.getElementById("game-title-input").value

    if (!gameTitle) {
      alert("ゲームタイトルを入力するでおじゃ！")
      return
    }

    const btn = document.getElementById("predict-btn")
    btn.disabled = true
    btn.textContent = "🔮 水晶玉を覗いておる...しばし待たれい..."
    btn.classList.add("opacity-60")

    const response = await fetch("/uranai/predict", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
      },
      body: JSON.stringify({ game_title: gameTitle })
    })

    const data = await response.json()

    const cards = data.predictions.map((p, i) => `
      <div class="rounded-xl border border-blue-700 p-6 shadow-lg" style="background-color: white;">
        <p class="text-yellow-500 text-xs tracking-widest mb-1">第${i + 1}の予言</p>
        <h3 class="text-gray-800 font-bold text-lg mb-2">🎮 ${p.title}</h3>
        <p class="text-gray-600 text-sm leading-relaxed">${p.message}</p>
      </div>
    `).join("")

    document.getElementById("result-cards").innerHTML = cards
    document.getElementById("result").style.display = "block"

    btn.disabled = false
    btn.textContent = "🔮 占う"
    btn.classList.remove("opacity-60")
  }
</script>