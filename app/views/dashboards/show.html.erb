<div class="container mx-auto px-4 py-8">
  <!-- ページヘッダー -->
  <div class="text-center mb-8">
    <h1 class="text-4xl font-bold text-white mb-2"><%= current_user.name %>の冒険の記録</h1>
    <p class="text-white">あの頃遊んだゲームの思い出を振り返ろう</p>
  </div>

  <!-- ゲーム検索 -->
<div class="mb-8 flex justify-center px-4">
  <%= form_tag dashboard_path, method: :get, class: "flex gap-2 items-center w-full max-w-md" do %>
    <%= text_field_tag :title, params[:title], 
        placeholder: "ゲームタイトルで検索", 
        class: "rpg-side-window px-4 py-2 text-white bg-transparent border border-blue-400 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 flex-1" %>
    <%= submit_tag "🔍", class: "rpg-command px-4 py-2 sm:hidden" %>
    <%= submit_tag "🔍 検索", class: "rpg-command px-4 py-2 hidden sm:block" %>
  <% end %>
</div>

  <% if @games.empty? %>
    <div class="text-center py-12">
      <div class="bg-gray-100 rounded-lg p-8 max-w-md mx-auto">
        <h2 class="text-2xl font-semibold text-gray-700 mb-4">ゲームデータがありません</h2>
        <p class="text-gray-600 mb-6">ゲームを登録して冒険を始めましょう！</p>
        <%= link_to "ゲーム登録", new_game_path, class: "bg-blue-600 hover:bg-blue-700 
          text-white font-bold py-2 px-4 rounded-lg
          transition duration-300"
        %>
      </div>
    </div>
  <% else %>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <% @games.each do |game| %>
        <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1 border border-gray-100 cursor-pointer"
             onclick="openModal('<%= j game.title %>', '<%= j "#{game.hardware} | #{game.genre}#{game.played_age.present? ? " | #{game.played_age_label}の思い出" : ""}" %>', '<%= j game.memo %>', <%= game.id %>)">
          <div class="aspect-video bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center relative overflow-hidden">
            <% if game.cover_image.attached? %>
              <%= image_tag game.cover_image, class: "w-full h-full object-cover transition-transform duration-300 hover:scale-105" %>
            <% else %>
              <div class="text-gray-400 text-sm font-medium">NO IMAGE</div>
            <% end %>
            <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 hover:opacity-100 transition-opacity duration-300"></div>
          </div>

          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-800 mb-3 leading-tight"><%= game.title %></h3>

            <div class="space-y-3 mb-5">
              <div class="flex items-center text-sm text-gray-600 bg-gray-50 rounded-lg px-3 py-2">
                <span class="font-medium mr-3 text-blue-600">🎮</span>
                <span class="font-medium"><%= game.hardware %></span>
              </div>
              <div class="flex items-center text-sm text-gray-600 bg-gray-50 rounded-lg px-3 py-2">
                <span class="font-medium mr-3 text-green-600">⚔️</span>
                <span class="font-medium"><%= game.genre %></span>
              </div>
              <% if game.played_age.present? %>
                <div class="flex items-center text-sm text-gray-600 bg-gray-50 rounded-lg px-3 py-2">
                  <span class="font-medium mr-3 text-purple-600">🕰</span>
                  <span class="font-medium"><%= game.played_age_label %>の思い出</span>
                </div>
              <% end %>
            </div>

            <!-- 楽しさと難しさの表示 -->
            <div class="bg-white rounded-lg shadow-md p-4 mb-5 border border-gray-200">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="font-medium text-green-700 text-sm">楽しさ:</span>
                  <div class="flex flex-row-reverse gap-1">
                    <% 10.downto(1) do |i| %>
                      <span class="materia materia-green inline-block <%= 'inactive' unless game.fun && game.fun >= i %>"></span>
                    <% end %>
                  </div>
                </div>
                <div class="flex items-center justify-between">
                  <span class="font-medium text-red-700 text-sm">難しさ:</span>
                  <div class="flex flex-row-reverse gap-1">
                    <% 10.downto(1) do |i| %>
                      <span class="materia materia-red inline-block <%= 'inactive' unless game.difficulty && game.difficulty >= i %>"></span>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>

            <% if game.memo.present? %>
              <div class="bg-gradient-to-r from-blue-50 to-purple-50 rounded-lg p-4 mb-5 border-l-4 border-blue-400">
                <p class="text-gray-700 text-sm italic leading-relaxed">"<%= game.memo %>"</p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<!-- ================= ゲーム詳細モーダル ================= -->
<div id="gameModal"
     class="fixed inset-0 hidden items-center justify-center
            bg-black/80 backdrop-blur-md z-50">

  <div class="w-full max-w-3xl relative
              bg-gradient-to-br from-blue-50 to-indigo-100 backdrop-blur-lg
              border-2 border-blue-300 rounded-xl
              shadow-[0_0_40px_rgba(59,130,246,0.6)]
              px-8 py-6 space-y-6
              transform scale-95 opacity-0 transition-all duration-300
              modal-enter:scale-100 modal-enter:opacity-100">

    <h2 id="modalTitle"
        class="text-2xl font-bold tracking-widest text-blue-900"></h2>

    <p id="modalMeta"
       class="text-sm tracking-wider text-blue-700 font-medium"></p>

    <div class="bg-blue-50/80 border border-blue-200 rounded-md p-4">
      <p id="modalMemo" class="text-blue-800 leading-relaxed"></p>
    </div>

    <div class="grid grid-cols-2 gap-6 pt-4">
      <a id="modalEdit"
         class="bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white text-center py-3 px-6 rounded-lg transition-all duration-300 transform hover:scale-105 shadow-md hover:shadow-lg font-medium"
         data-turbo-frame="modal">
        編集
      </a>

      <a id="modalDelete"
         class="bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white text-center py-3 px-6 rounded-lg transition-all duration-300 transform hover:scale-105 shadow-md hover:shadow-lg font-medium"
         data-turbo="false">
        削除
      </a>
    </div>

    <button onclick="closeModal()"
            class="absolute top-4 right-5 text-3xl
                   text-blue-400 hover:text-blue-600 transition-colors">
      ✕
    </button>

  </div>
</div>

<script>
  function openModal(title, meta, memo, gameId) {
    const modal = document.getElementById('gameModal')
    const modalContent = modal.querySelector('div > div')

    document.getElementById('modalTitle').innerText = title
    document.getElementById('modalMeta').innerText = meta
    document.getElementById('modalMemo').innerText = memo || "……"
    document.getElementById('modalEdit').href = `/games/${gameId}/edit`
    document.getElementById('modalDelete').href = `/games/${gameId}/confirm_destroy`

    modal.classList.remove('hidden')
    modal.classList.add('flex')

    // アニメーションで表示
    setTimeout(() => {
      modalContent.classList.remove('scale-95', 'opacity-0')
      modalContent.classList.add('scale-100', 'opacity-100')
    }, 10)
  }

  function closeModal() {
    const modal = document.getElementById('gameModal')
    const modalContent = modal.querySelector('div > div')

    // アニメーションで非表示
    modalContent.classList.remove('scale-100', 'opacity-100')
    modalContent.classList.add('scale-95', 'opacity-0')

    setTimeout(() => {
      modal.classList.add('hidden')
      modal.classList.remove('flex')
    }, 300)
  }

  document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('gameModal')
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) {
          closeModal()
        }
      })
    }

    // プログレスバーのアニメーション
    const progressBars = document.querySelectorAll('[data-width]')
    progressBars.forEach(bar => {
      const width = bar.getAttribute('data-width')
      setTimeout(() => {
        bar.style.width = width + '%'
      }, 100) // 少し遅延してアニメーション開始
    })
  })
</script>
