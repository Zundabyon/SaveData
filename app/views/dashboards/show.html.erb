<div class="min-h-screen text-slate-100 flex">

<!-- 中央：年表 -->
<main class="flex-1 px-6 py-12">

<header class="mb-16 text-center header-center">
  <h1 class="text-5xl md:text-3xl font-bold tracking-widest">
    <%= @user.name %>の冒険の記録
  </h1>
  <p class="mt-2 text-lg text-slate-400">セーブデータを選んでください</p>
</header>

<!-- スクロール制限 -->
<div class="relative max-w-5xl mx-auto
            overflow-y-auto overflow-x-visible
            max-h-[calc(100vh-6rem)] pr-6">

  <% @games.each do |game| %>
    <div class="relative pl-16 mb-12 flex gap-4 items-center">

      <!-- 年マーカー -->
      <div class="year-marker font-sans">
        <%= game.played_age %>歳
      </div>

      <!-- 画像サムネイル（年マーカーの右） -->
      <% if game.cover_image.attached? %>
        <div class="flex-shrink-0 group cursor-pointer"
            
             data-title="<%= game.title %>"
             data-meta="<%= [game.hardware, game.genre, (game.played_age.present? ? game.played_age.to_s + '歳' : nil)].compact.join(' / ') %>"
             data-memo="<%= game.memo %>"
             data-game-id="<%= game.id %>">
          <div class="relative overflow-hidden rounded-lg border-4 border-slate-600
                      hover:border-blue-500 transition-all duration-300 shadow-lg
                      hover:shadow-[0_0_20px_rgba(80,120,255,0.5)]
                      bg-slate-800/60 w-[250px]">
            <%= image_tag game.cover_image.variant(resize_to_fill: [230, 200]),
                class: "w-full h-44 object-cover group-hover:scale-110 transition-transform duration-300",
                loading: "lazy",
                alt: game.title %>
          </div>
        </div>
      <% end %>

      <!-- カード（画像の右側） -->
      <div class="flex-1 timeline-card bg-slate-800/60 backdrop-blur
                  border border-slate-700 rounded-xl
                  p-5 shadow-lg cursor-pointer
                  hover:border-slate-500 transition"
          
           data-title="<%= game.title %>"
           data-meta="<%= [game.hardware, game.genre, (game.played_age.present? ? game.played_age.to_s + '歳' : nil)].compact.join(' / ') %>"
           data-memo="<%= game.memo %>"
           data-game-id="<%= game.id %>">

        <h2 class="text-lg font-semibold tracking-wide"><%= game.title %></h2>
        <div class="mt-2 flex flex-wrap gap-3 text-xs text-slate-400">
          <% if game.hardware.present? %><span>🎮 <%= game.hardware %></span><% end %>
          <% if game.genre.present? %><span>⚔️ <%= game.genre %></span><% end %>
          <% if game.played_age.present? %><span>🕰 <%= game.played_age %>歳ころの思い出</span><% end %>
        </div>

        <!-- 評価 -->
        <div class="mt-3 flex gap-4 text-xs text-slate-300">
          <% if game.difficulty.present? %>
            <div class="space-y-1">
              <span class="block text-center">難易度</span>
              <div class="flex gap-1 justify-center">
                <% 10.times do |i| %>
                  <span class="materia materia-red <%= 'inactive' if i >= game.difficulty %>"></span>
                <% end %>
              </div>
            </div>
          <% end %>

          <% if game.fun.present? %>
            <div class="space-y-1">
              <span class="block text-center">面白さ</span>
              <div class="flex gap-1 justify-center">
                <% 10.times do |i| %>
                  <span class="materia materia-green <%= 'inactive' if i >= game.fun %>"></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <% if game.memo.present? %>
          <p class="mt-4 text-sm text-slate-300 leading-relaxed line-clamp-2">
            「<%= game.memo %>」
          </p>
        <% end %>

      </div>
    </div>
  <% end %>
</div>
</main>

<!-- 右：FF7メニュー -->
<aside class="hidden md:block w-72 relative">
  <div class="sticky top-20 mr-8">
    <div class="bg-[#0b0f2a]/90 backdrop-blur rounded-xl
                shadow-[0_0_30px_rgba(80,120,255,0.35)] px-8 py-6 space-y-6 rpg-side-window">

      <div class="space-y-4 text-center side-block">
        <!-- 職業画像（メニューの代わり） -->
        <% 
          # 日本語の職業名を英語ファイル名にマッピング
          job_images = {
            # 日本語名（古いデータ用）
            "せんし" => "warrior.png",
            "まほうつかい" => "mage.png",
            "とうぞく" => "thief.png",
            "そうりょ" => "priest.png",
            "ゆうしゃ" => "fighter.png",
            "しにがみ" => "devil.png",
            "Figmaしょくにん" => "figma_master.png",
            "ロブスター" => "lobster.png",
            "その他" => "other.png",
            # 英語名（selectで保存される値）
            "warrior" => "warrior.png",
            "mage" => "mage.png",
            "thief" => "thief.png",
            "priest" => "priest.png",
            "fighter" => "fighter.png",
            "devil" => "devil.png",
            "figma_master" => "figma_master.png",
            "lobster" => "lobster.png",
            "other" => "other.png"
          }

          job_image = job_images[@user.job] || "other.png"
        %>

        <div class="flex justify-center">
          <%= image_tag "jobs/#{job_image}",
              class: "w-48 h-48 object-contain mx-auto",
              alt: @user.job || "職業未設定" %>
        </div>

        <div class="user-info space-y-2">
          <div class="text-sm tracking-widest text-blue-200 opacity-80">プレイヤー</div>
          <div class="text-xl font-bold text-blue-100 tracking-wider">
            <%= @user.name.presence || "名無しの冒険者" %>
          </div>

          <div class="text-sm tracking-widest text-blue-200 opacity-80">レベル</div>
          <div class="text-xl font-bold text-blue-100 tracking-wider">
            <%= @user.level.presence || "1" %>
          </div>

          <div class="text-sm tracking-widest text-blue-200 opacity-80">しょくぎょう</div>
          <div class="text-xl font-bold text-blue-100">
            <%= job_hiragana(@user.job) %>
          </div>
        </div>

        <div class="flex flex-col gap-3">
          <%= link_to "ゲーム登録", new_game_path, class: "rpg-command text-center" %>
          <%= link_to "ユーザー編集", edit_user_registration_path, class: "rpg-command text-center" %>

          <% if user_signed_in? %>
            <%= button_to "ログアウト",
                  destroy_user_session_path,
                  method: :delete,
                  class: "rpg-command text-center bg-red-700 w-full" %>
          <% else %>
            <%= link_to "ログイン",
                  new_user_session_path,
                  class: "rpg-command text-center bg-red-700" %>
          <% end %>
        </div>

      </div>
    </div>
  </div>
</aside>

<!-- ===== FF7 詳細モーダル ===== -->
<div
     class="fixed inset-0 hidden items-center justify-center
            bg-black/70 backdrop-blur-sm z-50">

  <div class="w-full max-w-3xl relative
              bg-[#0b0f2a]/90 backdrop-blur
              border border-slate-700 rounded-xl
              shadow-[0_0_30px_rgba(80,120,255,0.35)]
              px-8 py-6 space-y-6">

    <!-- タイトル -->
    <h2
        class="text-2xl font-bold tracking-widest text-blue-100">
    </h2>

    <!-- メタ情報 -->
    <p
       class="text-sm tracking-wider text-blue-200/80">
    </p>

    <!-- メモ本文 -->
    <div class="bg-black/30 border border-blue-300/30 rounded-md p-4">
      <p class="text-slate-200 leading-relaxed"></p>
    </div>

    <!-- コマンド -->
    <div class="grid grid-cols-2 gap-6 pt-4">
      <a
         class="rpg-command text-center"
         data-turbo-frame="modal">
         へんしゅう
      </a>

      <a
        class="rpg-command text-center bg-red-700/20"
        data-turbo="false">
        さくじょ
      </a>
    </div>

    <!-- 閉じる -->
    <button data-action="click->game-modal#close"
            class="absolute top-4 right-5 text-3xl
                   text-slate-400 hover:text-white">
      ✕
    </button>

  </div>
</div>
</div>
<script>
  document.addEventListener('turbo:load', initGameModal)
  document.addEventListener('DOMContentLoaded', initGameModal)

  function initGameModal() {
    const modalElement = document.querySelector('[data-game-modal-target="modal"]')
    if (!modalElement) return

    // モーダルを開く
    document.querySelectorAll('[data-action*="game-modal#open"]').forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault()
        const title = this.dataset.title
        const meta = this.dataset.meta
        const memo = this.dataset.memo
        const gameId = this.dataset.gameId

        document.querySelector('[data-game-modal-target="title"]').innerText = title
        document.querySelector('[data-game-modal-target="meta"]').innerText = meta
        document.querySelector('[data-game-modal-target="memo"]').innerText = memo || "……"
        document.querySelector('[data-game-modal-target="edit"]').href = `/games/${gameId}/edit`
        document.querySelector('[data-game-modal-target="delete"]').href = `/games/${gameId}/confirm_destroy`

        modalElement.classList.remove('hidden')
        modalElement.classList.add('flex')
      })
    })

    // モーダルを閉じる
    const closeButton = document.querySelector('[data-action*="game-modal#close"]')
    if (closeButton) {
      closeButton.addEventListener('click', function(e) {
        e.preventDefault()
        modalElement.classList.add('hidden')
        modalElement.classList.remove('flex')
      })
    }
  }
</script>