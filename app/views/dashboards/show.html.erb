<div class="min-h-screen text-slate-100 flex px-4">

  <!-- 中央：年表 -->
<main class="flex-1 min-w-0 py-16">
    <header class="mb-16 text-center header-center">
      <h1 class="text-6xl md:text-5xl font-bold tracking-widest">
        <%= @user.name %>の冒険の記録
      </h1>
      <p class="mt-2 text-lg text-slate-400">セーブデータを選んでください</p>
    </header>

    <!-- スクロール制限 -->
    <div class="relative w-full
                overflow-y-auto overflow-x-visible
                max-h-[calc(100vh-6rem)] pr-6">

      <% @games.each do |game| %>
        <div class="relative pl-24 mb-12 flex gap-4 items-center">

          <!-- 画像サムネイル -->
          <% if game.cover_image.attached? %>
            <div class="flex-shrink-0 group cursor-pointer"
                 onclick="openModal('<%= j game.title %>', '<%= j [game.hardware, game.genre, (game.played_age.present? ? game.played_age.to_s + '歳' : nil)].compact.join(' / ') %>', '<%= j game.memo %>', '<%= game.id %>')">

              <div class="relative overflow-hidden rounded-lg border-9 border-slate-600
                          hover:border-blue-500 transition-all duration-300 shadow-lg
                          hover:shadow-[0_0_20px_rgba(80,120,255,0.5)]
                          bg-slate-800/60 w-[250px]">

                <%= image_tag game.cover_image,
                    class: "w-50 h-50 object-cover group-hover:scale-110 transition-transform duration-300",
                    loading: "lazy",
                    alt: game.title %>
              </div>
            </div>
          <% end %>

          <!-- カード -->
          <div class="flex-1 timeline-card bg-slate-800/60 backdrop-blur
                      border border-slate-700 rounded-xl
                      p-8 shadow-lg cursor-pointer
                      hover:border-slate-500 transition"
               onclick="openModal('<%= j game.title %>', '<%= j [game.hardware, game.genre, (game.played_age.present? ? game.played_age.to_s + '歳' : nil)].compact.join(' / ') %>', '<%= j game.memo %>', '<%= game.id %>')">

            <div class="flex items-center gap-4 flex-wrap">

              <!-- タイトル -->
              <h2 class="text-2xl font-semibold tracking-wide">
                <%= game.title %>
              </h2>

              <!-- メタ情報 -->
              <div class="flex flex-wrap gap-3 text-l text-slate-400">
                <% if game.hardware.present? %>
                  <span>🎮 <%= game.hardware %></span>
                <% end %>
                <% if game.genre.present? %>
                  <span>⚔️ <%= game.genre %></span>
                <% end %>
                <% if game.played_age.present? %>
                  <span>🕰 <%= game.played_age %>歳ころの思い出</span>
                <% end %>
              </div>
            </div>

            <!-- 評価 -->
            <div class="mt-4 flex gap-8 text-base text-slate-200">

              <% if game.difficulty.present? %>
                <div class="space-y-2">
                  <span class="block text-center">難易度</span>
                  <div class="flex gap-1 justify-center">
                    <% 10.times do |i| %>
                      <span class="materia materia-red <%= 'inactive' if i >= game.difficulty %>"></span>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <% if game.fun.present? %>
                <div class="space-y-1">
                  <span class="block text-center">面白さ</span>
                  <div class="flex gap-1 justify-center">
                    <% 10.times do |i| %>
                      <span class="materia materia-green <%= 'inactive' if i >= game.fun %>"></span>
                    <% end %>
                  </div>
                </div>
              <% end %>

            </div>

            <% if game.memo.present? %>
              <p class="mt-4 text-xl text-slate-300 leading-relaxed line-clamp-2">
                「<%= game.memo %>」
              </p>
            <% end %>

          </div>
        </div>
      <% end %>

    </div>
  </main>

  <!-- 右：FF7メニュー -->
  <aside class="hidden md:block w-72 flex-shrink-0 ml-8">

    <div class="sticky top-20 mr-8">
      <div class="bg-[#0b0f2a]/90 backdrop-blur rounded-xl
                  shadow-[0_0_30px_rgba(80,120,255,0.35)] px-8 py-6 space-y-6 rpg-side-window">

        <div class="space-y-4 text-center side-block">

          <% 
            job_images = {
              "せんし" => "warrior.png",
              "まほうつかい" => "mage.png",
              "とうぞく" => "thief.png",
              "そうりょ" => "priest.png",
              "ゆうしゃ" => "fighter.png",
              "しにがみ" => "devil.png",
              "Figmaしょくにん" => "figma_master.png",
              "ロブスター" => "lobster.png",
              "その他" => "other.png",
              "warrior" => "warrior.png",
              "mage" => "mage.png",
              "thief" => "thief.png",
              "priest" => "priest.png",
              "fighter" => "fighter.png",
              "devil" => "devil.png",
              "figma_master" => "figma_master.png",
              "lobster" => "lobster.png",
              "other" => "other.png"
            }

            job_image = job_images[@user.job] || "other.png"
          %>

          <div class="flex justify-center">
            <%= image_tag "jobs/#{job_image}",
                class: "w-48 h-48 object-contain mx-auto",
                alt: @user.job || "職業未設定" %>
          </div>

          <div class="user-info space-y-2">
            <div class="text-sm tracking-widest text-blue-200 opacity-80">プレイヤー</div>
            <div class="text-xl font-bold text-blue-100 tracking-wider">
              <%= @user.name.presence || "名無しの冒険者" %>
            </div>

            <div class="text-sm tracking-widest text-blue-200 opacity-80">レベル</div>
            <div class="text-xl font-bold text-blue-100 tracking-wider">
              <%= @user.level.presence || "1" %>
            </div>

            <div class="text-sm tracking-widest text-blue-200 opacity-80">しょくぎょう</div>
            <div class="text-xl font-bold text-blue-100">
              <%= job_hiragana(@user.job) %>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <%= link_to "ゲーム登録", new_game_path, class: "rpg-command text-center" %>
            <%= link_to "ユーザー編集", edit_user_registration_path, class: "rpg-command text-center" %>

            <% if user_signed_in? %>
              <%= button_to "ログアウト",
                    destroy_user_session_path,
                    method: :delete,
                    class: "rpg-command text-center bg-red-700 w-full" %>
            <% else %>
              <%= link_to "ログイン",
                    new_user_session_path,
                    class: "rpg-command text-center bg-red-700" %>
            <% end %>
          </div>

        </div>
      </div>
    </div>
  </aside>

  <!-- モーダル -->
  <div id="gameModal"
       class="fixed inset-0 hidden items-center justify-center
              bg-black/70 backdrop-blur-sm z-50">

    <div class="w-full max-w-3xl relative
                bg-[#0b0f2a]/90 backdrop-blur
                border border-slate-700 rounded-xl
                shadow-[0_0_30px_rgba(80,120,255,0.35)]
                px-8 py-6 space-y-6">

      <h2 id="modalTitle"
          class="text-2xl font-bold tracking-widest text-blue-100"></h2>

      <p id="modalMeta"
         class="text-sm tracking-wider text-blue-200/80"></p>

      <div class="bg-black/30 border border-blue-300/30 rounded-md p-4">
        <p id="modalMemo" class="text-slate-200 leading-relaxed"></p>
      </div>

      <div class="grid grid-cols-2 gap-6 pt-4">
        <a id="modalEdit"
           class="rpg-command text-center"
           data-turbo-frame="modal">
          へんしゅう
        </a>

        <a id="modalDelete"
           class="rpg-command text-center bg-red-700/20"
           data-turbo="false">
          さくじょ
        </a>
      </div>

      <button onclick="closeModal()"
              class="absolute top-4 right-5 text-3xl
                     text-slate-400 hover:text-white">
        ✕
      </button>

    </div>
  </div>

</div>

<script>
function openModal(title, meta, memo, gameId) {
  const modal = document.getElementById('gameModal')
  document.getElementById('modalTitle').innerText = title
  document.getElementById('modalMeta').innerText = meta
  document.getElementById('modalMemo').innerText = memo || "……"
  document.getElementById('modalEdit').href = `/games/${gameId}/edit`
  document.getElementById('modalDelete').href = `/games/${gameId}/confirm_destroy`

  modal.classList.remove('hidden')
  modal.classList.add('flex')
}

function closeModal() {
  const modal = document.getElementById('gameModal')
  modal.classList.add('hidden')
  modal.classList.remove('flex')
}

document.addEventListener('DOMContentLoaded', function() {
  const modal = document.getElementById('gameModal')
  if (modal) {
    modal.addEventListener('click', function(e) {
      if (e.target === modal) {
        closeModal()
      }
    })
  }
})
</script>
