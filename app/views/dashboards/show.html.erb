<div class="min-h-screen text-slate-100 flex">

  <!-- 左：ダミー余白 -->
  <aside class="hidden md:block w-70"></aside>

<!-- 中央：年表 -->
<main class="flex-1 px-6 py-12">

  <header class="mb-16 text-center">
    <h1 class="text-3xl md:text-4xl font-bold tracking-widest">
      <%= @user.name %> の冒険の記録
    </h1>
    <p class="mt-2 text-sm text-slate-400">セーブデータを選んでください</p>
  </header>

    <!-- スクロール制限 -->
    <div class="relative max-w-5xl mx-auto overflow-y-auto max-h-[calc(100vh-6rem)] pr-6">

      <!-- 縦線はフローに沿って描画 -->
      <div class="absolute left-4 top-0 bottom-0 w-px bg-slate-700"></div>

      <% @games.each do |game| %>
        <% next if game.title.blank? || game.played_age.blank? %>

<!-- 全体をflexで横並び -->
<div class="relative pl-12 mb-12 flex gap-4 items-center">
  <!-- ↑ items-start を items-center に変更 -->
  
  <!-- 年マーカー -->
  <div class="absolute left-0 top-1 w-8 h-8 rounded-full
              bg-slate-800/40 border border-slate-600/40
              flex items-center justify-center
              text-xs font-semibold text-slate-300 year-marker">
    <%= game.played_age %>歳
  </div>
 <!-- 画像サムネイル（年マーカーの右） -->
  <% if game.cover_image.attached? %>
    <div class="flex-shrink-0 group cursor-pointer"
         onclick="openModal(
           '<%= j game.title %>',
           '<%= j [game.hardware, game.genre, (game.played_age.present? ? game.played_age.to_s + '歳' : nil)].compact.join(' / ') %>',
           '<%= j game.memo %>',
           <%= game.id %>
         )">
      <div class="relative overflow-hidden rounded-lg border-4 border-slate-600
                  hover:border-blue-500 transition-all duration-300 shadow-lg
                  hover:shadow-[0_0_20px_rgba(80,120,255,0.5)]
                  bg-slate-800/60 w-[250px]">
        <%= image_tag game.cover_image.variant(resize_to_fill: [230, 200]),
            class: "w-full h-44 object-cover group-hover:scale-110 transition-transform duration-300",
            loading: "lazy",
            alt: game.title %>
  <!-- 再生アイコンオーバーレイ -->
        <div class="absolute inset-0 flex items-center justify-center
                    opacity-0 group-hover:opacity-100 transition-opacity
                    bg-black/30">
          <div class="w-16 h-16 rounded-full bg-blue-500/80 flex items-center justify-center">
            <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  <% end %>

<!-- カード（画像の右側） -->
  <div class="flex-1 timeline-card bg-slate-800/60 backdrop-blur
              border border-slate-700 rounded-xl
              p-5 shadow-lg cursor-pointer
              hover:border-slate-500 transition"
       onclick="openModal(
         '<%= j game.title %>',
         '<%= j [game.hardware, game.genre, (game.played_age.present? ? game.played_age.to_s + '歳' : nil)].compact.join(' / ') %>',
         '<%= j game.memo %>',
         <%= game.id %>
       )">

            <h2 class="text-lg font-semibold tracking-wide"><%= game.title %></h2>
            <div class="mt-2 flex flex-wrap gap-3 text-xs text-slate-400">
              <% if game.hardware.present? %><span>🎮 <%= game.hardware %></span><% end %>
              <% if game.genre.present? %><span>⚔️ <%= game.genre %></span><% end %>
              <% if game.played_age.present? %><span>🕰 <%= game.played_age %>歳</span><% end %>
            </div>

            <!-- 評価 -->
            <div class="mt-3 space-y-2 text-xs text-slate-300">
              <% if game.difficulty.present? %>
                <div class="flex items-center gap-2">
                  <span class="w-14">難易度</span>
                  <div class="flex gap-1">
                    <% 5.times do |i| %>
                      <span class="materia materia-red <%= 'inactive' if i >= game.difficulty %>"></span>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <% if game.fun.present? %>
                <div class="flex items-center gap-2">
                  <span class="w-14">面白さ</span>
                  <div class="flex gap-1">
                    <% 5.times do |i| %>
                      <span class="materia materia-green <%= 'inactive' if i >= game.fun %>"></span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>

            <% if game.memo.present? %>
              <p class="mt-4 text-sm text-slate-300 leading-relaxed line-clamp-2">
                「<%= game.memo %>」
              </p>
            <% end %>

          </div>
        </div>
      <% end %>
    </div>
  </main>

  <!-- 右：FF7メニュー -->
  <aside class="hidden md:block w-72 relative">
    <div class="sticky top-20 mr-8">
      <div class="bg-[#0b0f2a]/90 backdrop-blur rounded-xl
                  shadow-[0_0_30px_rgba(80,120,255,0.35)] px-8 py-6 space-y-6 rpg-side-window">

        <div class="space-y-8 text-center side-block">
          <div class="text-lg tracking-widest text-blue-200 opacity-80 font-pixel">メニュー</div>

          <div class="user-info space-y-2">
            <div class="text-xs tracking-widest text-blue-200 opacity-80">プレイヤー</div>
            <div class="text-lg font-bold text-blue-100 tracking-wider">
              <%= @user.name.presence || "名無しの冒険者" %>
            </div>

            <div class="text-xs tracking-widest text-blue-200 opacity-80">レベル</div>
            <div class="text-lg font-bold text-blue-100 tracking-wider">
              <%= @user.level.presence || "1" %>
            </div>

            <div class="text-xs tracking-widest text-blue-200 opacity-80">しょくぎょう</div>
            <div class="text-lg font-bold text-blue-100 tracking-wider">
              <%= @user.job.presence || "むしょく" %>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <%= link_to "ゲーム登録", new_game_path, class: "rpg-command text-center" %>
            <%= link_to "ユーザー編集", edit_user_registration_path, class: "rpg-command text-center" %>

            <% if user_signed_in? %>
              <%= button_to "ログアウト",
                    destroy_user_session_path,
                    method: :delete,
                    class: "rpg-command text-center bg-red-700 w-full" %>
            <% else %>
              <%= link_to "ログイン",
                    new_user_session_path,
                    class: "rpg-command text-center bg-red-700" %>
            <% end %>
          </div>

        </div>
      </div>
    </div>
  </aside>

</div>

<!-- ===== FF7 詳細モーダル ===== -->
<div id="game-modal"
     class="fixed inset-0 hidden items-center justify-center
            bg-black/70 backdrop-blur-sm z-50">

  <div class="w-full max-w-3xl relative
              bg-[#0b0f2a]/90 backdrop-blur
              border border-slate-700 rounded-xl
              shadow-[0_0_30px_rgba(80,120,255,0.35)]
              px-8 py-6 space-y-6">

    <!-- タイトル -->
    <h2 id="modal-title"
        class="text-2xl font-bold tracking-widest text-blue-100">
    </h2>

    <!-- メタ情報 -->
    <p id="modal-meta"
       class="text-sm tracking-wider text-blue-200/80">
    </p>

    <!-- メモ本文 -->
    <div class="bg-black/30 border border-blue-300/30 rounded-md p-4">
      <p id="modal-memo" class="text-slate-200 leading-relaxed"></p>
    </div>

    <!-- コマンド -->
    <div class="grid grid-cols-2 gap-6 pt-4">
      <a id="modal-edit"
         class="rpg-command text-center"
         data-turbo-frame="modal">
         へんしゅう
      </a>

      <a id="modal-delete"
         class="rpg-command text-center bg-red-700/20
                border-red-400/40 text-red-300
                hover:border-red-300"
         data-turbo-frame="modal">
         さくじょ
      </a>
    </div>

    <!-- 閉じる -->
    <button onclick="closeModal()"
            class="absolute top-4 right-5 text-3xl
                   text-slate-400 hover:text-white">
      ✕
    </button>

  </div>
</div>

<script>
  const gameModal   = document.getElementById("game-modal")
  const modalTitle  = document.getElementById("modal-title")
  const modalMeta   = document.getElementById("modal-meta")
  const modalMemo   = document.getElementById("modal-memo")
  const modalEdit   = document.getElementById("modal-edit")
  const modalDelete = document.getElementById("modal-delete")

  function openModal(title, meta, memo, gameId) {
    modalTitle.innerText = title
    modalMeta.innerText  = meta
    modalMemo.innerText  = memo || "……"

    modalEdit.href   = `/games/${gameId}/edit`
    modalDelete.href = `/games/${gameId}/confirm_destroy`

    gameModal.classList.remove("hidden")
    gameModal.classList.add("flex")
  }

  function closeModal() {
    gameModal.classList.add("hidden")
    gameModal.classList.remove("flex")
  }
</script>