<div class="container mx-auto px-4 py-8">
  <!-- ページヘッダー -->
  <div class="text-center mb-8">
    <h1 class="text-4xl font-bold text-white mb-2"><%= current_user.name %>の<br>冒険の記録</h1>
    <p class="text-white">あの頃遊んだゲームの思い出を振り返ろう</p>
  </div>

  <!-- ゲーム検索 -->
  <div class="mb-8 flex justify-center px-4">
    <%= form_tag dashboard_path, method: :get, class: "flex gap-2 items-center w-full max-w-lg" do %>
      <%= text_field_tag :title, params[:title],
          placeholder: "ゲームタイトルで検索",
          class: "rpg-side-window px-4 py-2 text-white bg-transparent border border-blue-400 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 min-w-0 flex-1" %>
      <%= submit_tag "🔍", class: "rpg-command !px-2 !py-1 !text-xs whitespace-nowrap flex-shrink-0 sm:hidden" %>
      <%= submit_tag "🔍 検索", class: "rpg-command !px-2 !py-1 !text-xs whitespace-nowrap flex-shrink-0 hidden sm:block" %>
    <% end %>
  </div>

  <!-- ゲームがない時の処理 -->
  <% if @games.empty? %>
    <div class="text-center py-12">
      <div class="bg-gray-100 rounded-lg p-8 max-w-md mx-auto">
        <h2 class="text-2xl font-semibold text-gray-700 mb-4">ゲームデータがありません</h2>
        <p class="text-gray-600 mb-6">ゲームを登録して冒険を始めましょう！</p>
        <%= link_to "ゲーム登録", new_game_path, class: "bg-blue-600 hover:bg-blue-700 
          text-white font-bold py-2 px-4 rounded-lg
          transition duration-300"
        %>
      </div>
    </div>
  <% else %>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <% @games.each do |game| %>
        <%= render 'games/game_card', game: game %>
      <% end %>
    </div>
  <% end %>

<!-- ================= ゲーム詳細モーダル ================= -->
<div id="gameModal"
     class="fixed inset-0 hidden items-center justify-center
            bg-black/80 backdrop-blur-md z-50">

  <div class="w-full max-w-3xl relative
              bg-gradient-to-br from-blue-50 to-indigo-100 backdrop-blur-lg
              border-2 border-blue-300 rounded-xl
              shadow-[0_0_40px_rgba(59,130,246,0.6)]
              px-8 py-6 space-y-6
              transform scale-95 opacity-0 transition-all duration-300
              modal-enter:scale-100 modal-enter:opacity-100">

    <h2 id="modalTitle"
        class="text-2xl font-bold tracking-widest text-blue-900"></h2>

    <p id="modalMeta"
       class="text-sm tracking-wider text-blue-700 font-medium"></p>

    <div class="bg-blue-50/80 border border-blue-200 rounded-md p-4">
      <p id="modalMemo" class="text-blue-800 leading-relaxed"></p>
    </div>

    <div class="grid grid-cols-2 gap-6 pt-4">
      <a id="modalEdit"
         class="bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white text-center py-3 px-6 rounded-lg transition-all duration-300 transform hover:scale-105 shadow-md hover:shadow-lg font-medium"
         data-turbo-frame="modal">
        編集
      </a>

      <a id="modalDelete"
         class="bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white text-center py-3 px-6 rounded-lg transition-all duration-300 transform hover:scale-105 shadow-md hover:shadow-lg font-medium"
         data-turbo="false">
        削除
      </a>
    </div>

    <div class="pt-2">
      <button onclick="shareCard(window.currentGameId)"
              class="w-full rounded-xl bg-sky-400 py-3 text-white font-semibold
                    shadow-md hover:bg-sky-500 transition">
        𝕏 ゲームの思い出をシェア
      </button>
    </div>

    <button onclick="closeModal()"
            class="absolute top-4 right-5 text-3xl
                   text-blue-400 hover:text-blue-600 transition-colors">
      ✕
    </button>

  </div>
</div>

