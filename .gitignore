# Bundlerの設定ファイル（ローカル環境依存のため除外）
/.bundle

# 環境変数ファイル（APIキーやDB情報が入るため絶対にGit管理しない）
/.env*
# ただし .env*.erb（テンプレート）は管理対象に戻す
!/.env*.erb

# ログファイルは除外（容量が大きくなるため）
/log/*
# ただし log/ フォルダ自体は残す
!/log/.keep

# 一時ファイルは除外
/tmp/*
!/tmp/.keep

# PumaのプロセスIDファイルは除外
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Active Storageのローカルファイルは除外（Cloudinaryを使うので不要）
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# アセットのビルド成果物は除外（デプロイ時に自動生成されるため）
/public/assets

# 暗号化キー（流出すると全credentials.yml.encが復号される。絶対にNG）
/config/master.key

# TailwindCSSのビルド成果物は除外
/app/assets/builds/*
!/app/assets/builds/.keep

# npmパッケージは除外（bundle installと同様、都度インストールするため）
/node_modules

# SimpleCovのカバレッジレポートは除外（ローカル確認用のHTMLなのでGit不要）
/coverage